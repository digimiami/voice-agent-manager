        <span><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#252533;border:1px solid #3a3a4c;margin-right:4px"></span>📝 Has notes</span>
        <span><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#38bdf8;margin-right:4px"></span>🤖 AI Confirmed</span>
      </div>
    </div>

    <!-- Selected-day appointments -->
    <div id="calDayDetail" class="card hidden mb-4">
      <h4 class="font-bold text-sm mb-3" id="calDayTitle">📅 Appointments</h4>
      <div id="calDayList" class="space-y-2"></div>
    </div>
  </div>

  <!-- LIST view -->
  <div id="calListView">
  <!-- Appointment List -->
  <div class="card">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-bold">📅 Upcoming Appointments</h3>
      <span class="text-xs text-[#7a7a8e]">{{ appointments|length }} total</span>
    </div>
    {% if appointments %}
    <div class="space-y-3">
      {% for apt in appointments %}
      <div class="bg-[#1a1a26] rounded-xl p-4 border {% if apt.status == 'completed' %}border-[#22c55e]/30{% else %}border-[#252533]{% endif %} hover:border-[#a855f7]/30 transition-all">
        <div class="flex items-start justify-between mb-2">
          <div>
            <div class="font-semibold text-sm flex items-center gap-2 {% if apt.status == 'completed' %}line-through opacity-60{% endif %}">
              <span class="w-8 h-8 rounded-full bg-[#a855f7]/20 flex items-center justify-center text-sm">👤</span>
              {{ apt.prospect_name or apt.lead_name or 'Prospect' }}
            </div>
            <div class="text-xs text-[#7a7a8e] mt-1">{{ apt.phone or '' }}</div>
          </div>
          <div class="text-right">
            {% if apt.source == 'ai' %}
            <span class="badge text-xs mb-1" style="background:#38bdf820;color:#38bdf8">🤖 AI Confirmed</span>
            {% endif %}
            {% if apt.status == 'completed' %}
            <span class="badge text-xs" style="background:#22c55e20;color:#4ade80">✅ Completed</span>
            {% else %}
            <span class="badge badge-success text-xs">📅 Booked</span>
            {% endif %}
            <div class="text-xs text-[#7a7a8e] mt-1">{{ apt.appointment_time or 'No time set' }}</div>
            {% if apt.reminder_sent_at %}
            <div class="text-[11px] text-[#4ade80] mt-1">🔔 Reminder sent {{ apt.reminder_sent_at[:16] }}</div>
            {% endif %}
          </div>
        </div>
        {% if apt.notes %}
        <div class="text-xs text-[#94a3b8] mt-2 bg-[#12121a] rounded-lg p-3">
          <span class="text-[#64748b]">📝 Notes:</span> {{ apt.notes[:200] }}
        </div>
        {% endif %}
        <div class="flex items-center gap-2 mt-3">
          {% if apt.status == 'completed' %}
          <button onclick="aptAction('reopen','{{ apt.id }}')" class="px-3 py-1.5 rounded-lg text-xs font-semibold" style="background:#1a1a28;border:1px solid #252533;color:#cbd5e1">↩️ Reopen</button>
          {% else %}
          <button onclick="aptAction('complete','{{ apt.id }}')" class="px-3 py-1.5 rounded-lg text-xs font-semibold" style="background:#22c55e20;border:1px solid #22c55e40;color:#4ade80">✅ Mark Complete</button>
          {% endif %}
          <button onclick="aptAction('delete','{{ apt.id }}')" class="px-3 py-1.5 rounded-lg text-xs font-semibold" style="background:#ef444410;border:1px solid #ef444440;color:#f87171">🗑️ Delete</button>
          {% if apt.call_log_id %}
          <a href="/calendar/download/{{ apt.call_log_id }}" class="ml-auto text-xs text-[#38bdf8] hover:underline">
            <i class="fas fa-download mr-1"></i>📥 Download .ics
          </a>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="text-center py-12">
      <div class="text-4xl mb-3">📅</div>
      <p class="text-[#7a7a8e] font-medium">No appointments yet</p>
      <p class="text-xs text-[#5c5c70] mt-1">Appointments will appear here when your AI agent books them.</p>
    </div>
    {% endif %}
  </div>
  </div>

  <script>
  var CAL_EVENTS = {{ calendar_events|tojson }};
  var calCursor = new Date();
  var calSelected = null;

  function calView(v) {
    document.getElementById('calMonthView').classList.toggle('hidden', v !== 'month');
    document.getElementById('calListView').classList.toggle('hidden', v !== 'list');
    document.getElementById('calBtnMonth').style.background = v === 'month' ? 'linear-gradient(135deg,#a855f7,#ec4899)' : '';
    document.getElementById('calBtnMonth').style.color = v === 'month' ? '#fff' : '';
    document.getElementById('calBtnList').style.background = v === 'list' ? 'linear-gradient(135deg,#a855f7,#ec4899)' : '';
    document.getElementById('calBtnList').style.color = v === 'list' ? '#fff' : '';
    if (v === 'month') calRender();
  }

  function calEventsFor(dateStr) {
    return (CAL_EVENTS || []).filter(function(e){ return e.date === dateStr; });
  }

  function calRender() {
    var y = calCursor.getFullYear(), m = calCursor.getMonth();
    var label = calCursor.toLocaleDateString('en-US', {month: 'long', year: 'numeric'});
    document.getElementById('calMonthLabel').textContent = label;
    var grid = document.getElementById('calGrid');
    grid.innerHTML = '';
    var first = new Date(y, m, 1);
    var startPad = first.getDay();
    var daysInMonth = new Date(y, m + 1, 0).getDate();
    var todayStr = new Date().toISOString().slice(0, 10);
    for (var i = 0; i < startPad; i++) {
      var pad = document.createElement('div');
      pad.className = 'min-h-[64px] rounded-xl bg-[#12121a]/40';
      grid.appendChild(pad);
    }
    for (var d = 1; d <= daysInMonth; d++) {
      var dateStr = y + '-' + String(m + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
      var evs = calEventsFor(dateStr);
      var cell = document.createElement('div');
      cell.className = 'min-h-[64px] rounded-xl p-1.5 cursor-pointer border transition-all ' +
        (dateStr === todayStr ? 'border-[#a855f7]/60 bg-[#a855f7]/10' : 'border-[#252533] bg-[#1a1a26] hover:border-[#a855f7]/40');
      cell.onclick = function(ds){ return function(){ calSelect(ds); }; }(dateStr);
      var dayNum = '<div class="text-xs font-bold ' + (dateStr === todayStr ? 'text-[#c084fc]' : 'text-[#cbd5e1]') + '">' + d + '</div>';
      var dots = '';
      for (var j = 0; j < Math.min(evs.length, 3); j++) {
        var ev = evs[j];
        var done = ev.status === 'completed';
        var noteMark = ev.notes ? ' 📝' : '';
        var aiMark = ev.source === 'ai' ? '🤖 ' : '';
        dots += '<div class="mt-0.5 text-[9px] leading-tight truncate rounded px-1 py-0.5" style="' +
                (done ? 'background:#22c55e20;color:#4ade80' : 'background:#a855f720;color:#c084fc') + '">' +
                (done ? '✓ ' : '') + aiMark + (ev.time ? ev.time + ' ' : '') + escHtml(ev.name) + noteMark + '</div>';
      }
      if (evs.length > 3) dots += '<div class="text-[9px] text-[#5c5c70] mt-0.5">+' + (evs.length - 3) + ' more</div>';
      cell.innerHTML = dayNum + dots;
      grid.appendChild(cell);
    }
  }

  function calSelect(dateStr) {
    calSelected = dateStr;
    var evs = calEventsFor(dateStr);
    var detail = document.getElementById('calDayDetail');
    var list = document.getElementById('calDayList');
    var d = new Date(dateStr + 'T00:00:00');
    document.getElementById('calDayTitle').textContent = '📅 ' + d.toLocaleDateString('en-US', {weekday: 'long', month: 'long', day: 'numeric'});
    list.innerHTML = '';
    if (!evs.length) {
      list.innerHTML = '<div class="text-xs text-[#5c5c70] text-center py-4">No appointments this day.</div>';
    }
    evs.forEach(function(e){
      var card = document.createElement('div');
      card.className = 'bg-[#1a1a26] rounded-xl p-4 border ' + (e.status === 'completed' ? 'border-[#22c55e]/30' : 'border-[#252533]');
      var dl = e.call_log_id ? '<a href="/calendar/download/' + e.call_log_id + '" class="text-[10px] text-[#38bdf8] ml-2">📥 Download .ics</a>' : '';
      var bizLine = e.business_name ? '<div class="text-[11px] text-[#64748b] mt-0.5">🏢 ' + escHtml(e.business_name) + '</div>' : '';
      var leadLine = e.lead_name && e.lead_name !== e.name ? '<div class="text-[11px] text-[#64748b] mt-0.5">👤 Lead: ' + escHtml(e.lead_name) + '</div>' : '';
      var createdLine = e.created ? '<div class="text-[11px] text-[#64748b] mt-0.5">🗓️ Booked on ' + escHtml(e.created) + '</div>' : '';
      var rawLine = e.raw ? '<div class="text-[11px] text-[#64748b] mt-0.5">🕐 Said: "' + escHtml(e.raw) + '"</div>' : '';
      var remLine = e.reminder_sent ? '<div class="text-[11px] text-[#4ade80] mt-0.5">🔔 Reminder sent ' + escHtml(String(e.reminder_sent).slice(0, 16)) + '</div>' : '';
      var done = e.status === 'completed';
      var aiBadge = e.source === 'ai' ? '<span class="badge text-xs" style="background:#38bdf820;color:#38bdf8">🤖 AI Confirmed</span>' : '';
      var statusBadge = done
        ? '<span class="badge text-xs" style="background:#22c55e20;color:#4ade80">✅ Completed</span>'
        : '<span class="badge badge-success text-xs">📅 Booked</span>';
      var actionBtns = '<div class="flex items-center gap-2 mt-3">' +
        (done
          ? '<button onclick="aptAction(\'reopen\',\'' + e.id + '\')" class="px-3 py-1.5 rounded-lg text-xs font-semibold" style="background:#1a1a28;border:1px solid #252533;color:#cbd5e1">↩️ Reopen</button>'
          : '<button onclick="aptAction(\'complete\',\'' + e.id + '\')" class="px-3 py-1.5 rounded-lg text-xs font-semibold" style="background:#22c55e20;border:1px solid #22c55e40;color:#4ade80">✅ Mark Complete</button>') +
        '<button onclick="aptAction(\'delete\',\'' + e.id + '\')" class="px-3 py-1.5 rounded-lg text-xs font-semibold" style="background:#ef444410;border:1px solid #ef444440;color:#f87171">🗑️ Delete</button>' +
        '</div>';
      var transcriptBlock = e.transcript ? '<div class="mt-3"><div class="text-[10px] font-semibold text-[#5c5c70] uppercase mb-1">📝 Call transcript</div><div class="text-[11px] text-[#94a3b8] bg-[#12121a] rounded-lg p-2.5 max-h-28 overflow-y-auto leading-relaxed">' + escHtml(e.transcript) + '</div></div>' : '';
      var notesBlock = '<div class="mt-3"><div class="text-[10px] font-semibold text-[#5c5c70] uppercase mb-1">📋 Notes (click to edit)</div>' +
        '<textarea id="aptNotes_' + e.id + '" rows="3" class="w-full px-3 py-2 bg-[#12121a] rounded-lg border border-[#252533] text-xs leading-relaxed" placeholder="Add notes about this appointment...">' + escHtml(e.notes) + '</textarea>' +
        '<div class="flex items-center gap-2 mt-2"><button onclick="saveAptNotes(\'' + e.id + '\')" class="px-4 py-1.5 rounded-lg text-xs font-semibold" style="background:linear-gradient(135deg,#a855f7,#ec4899);color:#fff">💾 Save Notes</button>' +
        '<span id="aptNotesStatus_' + e.id + '" class="text-[11px] text-[#4ade80]"></span></div></div>';
      card.innerHTML = '<div class="flex items-start justify-between gap-2"><div class="min-w-0">' +
        '<div class="text-sm font-semibold' + (done ? ' line-through opacity-60' : '') + '">' + escHtml(e.name) + '</div>' +
        '<div class="text-xs text-[#c084fc] font-mono mt-0.5">' + (e.time || e.raw || 'TBD') + '</div>' +
        bizLine + leadLine + createdLine + rawLine + remLine +
        '<div class="text-xs text-[#7a7a8e] mt-0.5">📞 ' + escHtml(e.phone) + '</div>' +
        '</div><div class="text-right shrink-0">' + aiBadge + '<div class="mt-1">' + statusBadge + '</div><div class="mt-1">' + dl + '</div></div></div>' +
        actionBtns + notesBlock + transcriptBlock;
      list.appendChild(card);
    });
    detail.classList.remove('hidden');
  }

  function saveAptNotes(aptId) {
    var ta = document.getElementById('aptNotes_' + aptId);
    var status = document.getElementById('aptNotesStatus_' + aptId);
    var notes = ta.value;
    fetch('/api/appointment/notes', {method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({id: aptId, notes: notes})})
      .then(function(r){ return r.json(); })
      .then(function(d){
        if (d.success) {
          status.textContent = '✅ Saved';
          // update CAL_EVENTS cache
          (CAL_EVENTS || []).forEach(function(e){ if (e.id === aptId) e.notes = d.notes; });
          setTimeout(function(){ status.textContent = ''; }, 2000);
        } else {
          status.textContent = '❌ ' + (d.message || 'Failed');
          status.style.color = '#ef4444';
        }
      })
      .catch(function(){ status.textContent = '❌ Network error'; status.style.color = '#ef4444'; });
  }

  function calPrev() { calCursor.setMonth(calCursor.getMonth() - 1); calRender(); }
  function calNext() { calCursor.setMonth(calCursor.getMonth() + 1); calRender(); }

  // ── Auto reminders toggle / save ──
  function reminderToggleChanged(){
    var on = document.getElementById('reminderToggle').checked;
    var box = document.getElementById('reminderHoursBox');
    var st = document.getElementById('reminderStatus');
    if (box) box.classList.toggle('opacity-40', !on);
    if (box) box.classList.toggle('pointer-events-none', !on);
    if (st){
      st.textContent = on ? '● Reminders ON — 12h before, business hours only' : '○ Reminders OFF — toggle on to enable';
      st.style.color = on ? '#4ade80' : '#5c5c70';
    }
  }
  function saveReminderSettings(){
    var btn = document.getElementById('reminderSaveBtn');
    var st = document.getElementById('reminderStatus');
    var enabled = document.getElementById('reminderToggle').checked;
    var start = (document.getElementById('reminderStart') || {}).value || '09:00';
    var end = (document.getElementById('reminderEnd') || {}).value || '17:00';
    if (!start || !end){
      if (st){ st.textContent = '❌ Set both business hours'; st.style.color = '#ef4444'; }
      return;
    }
    btn.disabled = true; btn.textContent = 'Saving...';
    fetch('/api/reminder-settings', {method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({enabled: enabled, start: start, end: end})})
      .then(function(r){ return r.json(); })
      .then(function(d){
        btn.disabled = false; btn.textContent = '💾 Save Settings';
        if (st){
          st.textContent = d.success ? '✅ ' + d.message : '❌ ' + (d.message || 'Failed');
          st.style.color = d.success ? '#4ade80' : '#ef4444';
        }
        if (d.success) setTimeout(function(){ location.reload(); }, 800);
      })
      .catch(function(){
        btn.disabled = false; btn.textContent = '💾 Save Settings';
        if (st){ st.textContent = '❌ Network error'; st.style.color = '#ef4444'; }
      });
  }
  function sendRemindersNow(){
    var btn = document.getElementById('reminderSendNowBtn');
    var st = document.getElementById('reminderStatus');
    if (!confirm('Send reminders now for all appointments in the 12h window?')) return;
    btn.disabled = true; btn.textContent = 'Sending...';
    fetch('/api/reminders/send-now', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: '{}'})
      .then(function(r){ return r.json(); })
      .then(function(d){
        btn.disabled = false; btn.textContent = '📤 Send Reminders Now';
        if (st){
          st.textContent = d.success ? '✅ ' + d.message : '❌ ' + (d.message || 'Failed');
          st.style.color = d.success ? '#4ade80' : '#ef4444';
        }
      })
      .catch(function(){
        btn.disabled = false; btn.textContent = '📤 Send Reminders Now';
        if (st){ st.textContent = '❌ Network error'; st.style.color = '#ef4444'; }
      });
  }

  // ── Add / complete / reopen / delete appointments ──
  function showAddAptModal(){
    var el = document.getElementById('addAptModal');
    if (!el) return;
    var now = new Date();
    var pad = function(n){ return String(n).padStart(2, '0'); };
    var d = document.getElementById('addAptDate');
    if (d) d.value = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());
    var t = document.getElementById('addAptTime');
    if (t) t.value = pad((now.getHours() + 1) % 24) + ':00';
    ['addAptName','addAptPhone','addAptNotes'].forEach(function(id){
      var e = document.getElementById(id);
      if (e) e.value = '';
    });
    var err = document.getElementById('addAptError');
    if (err) err.classList.add('hidden');
    el.classList.add('show');
    var n = document.getElementById('addAptName');
    if (n) setTimeout(function(){ n.focus(); }, 50);
  }
  function closeAddAptModal(){
    var el = document.getElementById('addAptModal');
    if (el) el.classList.remove('show');
  }
  function submitAddApt(){
    var nameEl = document.getElementById('addAptName');
    var btn = document.getElementById('addAptBtn');
    var err = document.getElementById('addAptError');
    if (!nameEl || !nameEl.value.trim()){
      if (err){ err.textContent = 'Name is required'; err.classList.remove('hidden'); }
      return;
    }
    var payload = {
      name: nameEl.value.trim(),
      phone: (document.getElementById('addAptPhone') || {}).value || '',
      date: (document.getElementById('addAptDate') || {}).value || '',
      time: (document.getElementById('addAptTime') || {}).value || '',
      notes: (document.getElementById('addAptNotes') || {}).value || ''
    };
    btn.disabled = true; btn.textContent = 'Adding...';
    fetch('/api/appointment/add', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload)})
      .then(function(r){ return r.json(); })
      .then(function(d){
        btn.disabled = false; btn.textContent = '+ Add';
        if (d.success){ closeAddAptModal(); location.reload(); }
        else { if (err){ err.textContent = d.message || 'Failed'; err.classList.remove('hidden'); } }
      })
      .catch(function(){
        btn.disabled = false; btn.textContent = '+ Add';
        if (err){ err.textContent = 'Network error'; err.classList.remove('hidden'); }
      });
  }
  function aptAction(action, aptId){
    var url = action === 'complete' ? '/api/appointment/complete'
            : action === 'reopen' ? '/api/appointment/reopen'
            : '/api/appointment/delete';
    var msg = action === 'complete' ? 'Mark this appointment as completed?'
            : action === 'reopen' ? 'Reopen this appointment?'
            : 'Delete this appointment?';
    if (!confirm(msg)) return;
    fetch(url, {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({id: aptId})})
      .then(function(r){ return r.json(); })
      .then(function(d){ if (d.success) location.reload(); else alert(d.message || 'Failed'); })
      .catch(function(){ alert('Network error'); });
  }
  </script>

  <!-- Add Appointment modal -->
  <div id="addAptModal" class="modal-overlay" onclick="if(event.target===this)closeAddAptModal()">
    <div class="modal-content">
      <div class="flex justify-between items-center mb-4"><h3 class="font-bold">➕ Add Appointment</h3><button onclick="closeAddAptModal()" class="text-[#5c5c70] hover:text-white" style="font-size:24px;background:none;border:none;cursor:pointer">&times;</button></div>
      <div class="space-y-3">
        <input type="text" id="addAptName" placeholder="Name *">
        <input type="text" id="addAptPhone" placeholder="Phone">
        <div class="grid grid-cols-2 gap-2">
          <input type="date" id="addAptDate" style="width:100%;padding:10px 14px;border-radius:8px;border:1px solid #252533;background:#0c0c18;color:#f1f1f5;font-size:13px;font-family:inherit">
          <input type="time" id="addAptTime" style="width:100%;padding:10px 14px;border-radius:8px;border:1px solid #252533;background:#0c0c18;color:#f1f1f5;font-size:13px;font-family:inherit">
        </div>
        <textarea id="addAptNotes" rows="3" placeholder="Notes (optional)" style="width:100%;padding:10px 14px;border-radius:8px;border:1px solid #252533;background:#0c0c18;color:#f1f1f5;font-size:13px;resize:vertical;font-family:inherit"></textarea>
        <p id="addAptError" class="hidden text-red-400 text-xs"></p>
      </div>
      <div class="flex gap-2 mt-5"><button onclick="closeAddAptModal()" class="btn-secondary flex-1">Cancel</button><button id="addAptBtn" onclick="submitAddApt()" class="btn-primary flex-1">+ Add</button></div>
    </div>
  </div>

  <!-- ======== TAB: BILLING ======== -->
  {% elif tab == 'billing' %}
  <div class="max-w-3xl mx-auto">
    <h2 class="text-xl font-bold mb-6">💳 Subscription & Billing</h2>

    {% set used_min = (total_duration or 0) // 60 %}
    {% set limit_min = total_minutes_limit or user_tier.minutes_limit or 250 %}
    {% set pct = (used_min / limit_min * 100)|round|int if limit_min > 0 else 0 %}

    <!-- Current Plan Card -->
    <div class="card mb-4">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="font-bold text-lg">{{ user_tier.name }} Plan</h3>
          <p class="text-sm text-[#7a7a8e]">${{ user_tier.price }}/mo — {{ biz_info.status or 'Active' }}</p>
        </div>
        <span class="px-3 py-1 rounded-full text-xs font-semibold" style="background:#22c55e15;color:#4ade80">● Active</span>
      </div>

      <!-- Minutes Meter -->
      <div class="mb-4">
        <div class="flex items-center justify-between mb-1">
          <span class="text-sm text-[#cbd5e1] font-semibold">⏱ Call Minutes</span>
          <span class="text-xs font-mono text-[#7a7a8e]">{{ used_min }} / {{ limit_min }} min used</span>
        </div>
        <div style="height:10px;border-radius:5px;background:#1a1a28;overflow:hidden">
          <div style="height:100%;border-radius:5px;width:{{ pct }}%;{% if pct < 60 %}background:linear-gradient(90deg,#22c55e,#4ade80){% elif pct < 85 %}background:linear-gradient(90deg,#f59e0b,#fbbf24){% else %}background:linear-gradient(90deg,#ef4444,#f87171){% endif %}"></div>
        </div>
        <div class="flex justify-between mt-1 text-xs text-[#5c5c70]">
          <span>{{ limit_min - used_min }} min remaining</span>
          <span>{{ pct }}% used</span>
        </div>
      </div>

      <!-- Plan Features -->
      <div class="flex flex-wrap gap-2 mb-4">
        {% for f in user_tier.features %}
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-lg text-xs" style="background:#22c55e15;border:1px solid #22c55e30;color:#4ade80">✓ {{ f }}</span>
        {% endfor %}
      </div>
    </div>

    <!-- Buy More Minutes -->
