  </div>

  <!-- Buy a New Number -->
  <div class="card">
    <h3 class="font-bold mb-3">🔍 Buy a Number</h3>
    <p class="text-xs text-[#7a7a8e] mb-4">Search by area code or city/state to find available local numbers. $9.99/month billed via Stripe.</p>
    
