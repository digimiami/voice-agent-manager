<div id="editLeadModal" class="modal-overlay" onclick="if(event.target===this)closeEditLeadModal()">
  <div class="modal-content">
    <div class="flex justify-between items-center mb-4"><h3 class="font-bold">✏️ Edit Lead</h3><button onclick="closeEditLeadModal()" class="text-[#5c5c70] hover:text-white" style="font-size:24px;background:none;border:none;cursor:pointer">&times;</button></div>
    <div class="space-y-3">
      <input type="hidden" id="editLeadId">
      <input type="text" id="editLeadName" placeholder="Contact name">
      <input type="text" id="editLeadPhone" placeholder="Phone number *" required>
      <input type="text" id="editLeadBiz" placeholder="Business name">
      <textarea id="editLeadNotes" rows="3" placeholder="Knowledge / context about this lead (optional)" style="width:100%;padding:10px 14px;border-radius:8px;border:1px solid #252533;background:#0c0c18;color:#f1f1f5;font-size:13px;resize:vertical;font-family:inherit"></textarea>
      <p id="editLeadError" class="hidden text-red-400 text-xs"></p>
    </div>
    <div class="flex gap-2 mt-5"><button onclick="closeEditLeadModal()" class="btn-secondary flex-1">Cancel</button><button id="editLeadBtn" onclick="submitEditLead()" class="btn-primary flex-1">💾 Save</button></div>
  </div>
</div>

<script>
// Flash auto-hide
setTimeout(function(){document.querySelectorAll('.flash').forEach(function(e){e.style.opacity='0';setTimeout(function(){e.remove()},300)})},4000);
// Lead & Modal functions
function updateFollowup(leadId,field,value){fetch('/followup/update',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'lead_id='+encodeURIComponent(leadId)+'&field='+encodeURIComponent(field)+'&value='+encodeURIComponent(value)}).then(r=>r.json()).then(d=>{if(!d.success)alert('Error: '+d.message)}).catch(()=>{});}
function callSingleFollowup(leadId){if(!confirm('Call this lead now via AI?'))return;fetch('/followup/call',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'lead_id='+encodeURIComponent(leadId)}).then(r=>r.json()).then(d=>{alert(d.message);if(d.success)setTimeout(()=>location.reload(),2000)}).catch(()=>{});}
function callAllFollowups(){if(!confirm('Call ALL follow-up leads now?'))return;fetch('/followup/call-all',{method:'POST'}).then(r=>r.json()).then(d=>{alert(d.message);if(d.success)setTimeout(()=>location.reload(),2000)}).catch(()=>{});}
function callScheduledFollowups(){if(!confirm('Call only scheduled follow-ups?'))return;fetch('/followup/call-scheduled',{method:'POST'}).then(r=>r.json()).then(d=>{alert(d.message);if(d.success)setTimeout(()=>location.reload(),2000)}).catch(()=>{});}
function callLead(leadId){fetch('/lead/call/'+leadId,{method:'POST'}).then(r=>r.json()).then(d=>{alert(d.message);if(d.success)setTimeout(()=>location.reload(),2000)});}
function showAddLeadModal(){var el=document.getElementById('addLeadModal');if(!el)return;el.classList.add('show');var p=document.getElementById('addLeadModalPhone');if(p){p.value='';p.focus()}var n=document.getElementById('addLeadModalName');if(n)n.value='';var b=document.getElementById('addLeadModalBiz');if(b)b.value='';var nt=document.getElementById('addLeadModalNotes');if(nt)nt.value='';var e=document.getElementById('addLeadModalError');if(e)e.classList.add('hidden');}
function closeAddLeadModal(){var el=document.getElementById('addLeadModal');if(el)el.classList.remove('show');}
function submitAddLeadModal(){var phone=document.getElementById('addLeadModalPhone');var name=document.getElementById('addLeadModalName');var biz=document.getElementById('addLeadModalBiz');var notes=document.getElementById('addLeadModalNotes');var err=document.getElementById('addLeadModalError');var btn=document.getElementById('addLeadModalBtn');if(!phone||!btn||!err)return;if(!phone.value.trim()){err.textContent='Phone required';err.classList.remove('hidden');return}btn.disabled=true;btn.textContent='Adding...';fetch('/lead/add',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'XMLHttpRequest'},body:'phone='+encodeURIComponent(phone.value.trim())+'&name='+encodeURIComponent(name?name.value.trim():'')+'&business_name='+encodeURIComponent(biz?biz.value.trim():'')+'&notes='+encodeURIComponent(notes?notes.value.trim():'')}).then(function(r){return r.json()}).then(function(d){btn.disabled=false;btn.textContent='+ Add Lead';if(d.success){alert(d.message);closeAddLeadModal();location.reload()}else{err.textContent=d.message;err.classList.remove('hidden')}}).catch(function(){btn.disabled=false;btn.textContent='+ Add Lead';err.textContent='Network error';err.classList.remove('hidden')});}
function editLead(id,name,phone,business,notes){document.getElementById('editLeadId').value=id;document.getElementById('editLeadName').value=name;document.getElementById('editLeadPhone').value=phone;document.getElementById('editLeadBiz').value=business;var nt=document.getElementById('editLeadNotes');if(nt)nt.value=notes||'';document.getElementById('editLeadModal').classList.add('show');}
function closeEditLeadModal(){document.getElementById('editLeadModal').classList.remove('show');}
function submitEditLead(){var id=document.getElementById('editLeadId').value;var name=document.getElementById('editLeadName').value.trim();var phone=document.getElementById('editLeadPhone').value.trim();var biz=document.getElementById('editLeadBiz').value.trim();var notes=document.getElementById('editLeadNotes');var err=document.getElementById('editLeadError');var btn=document.getElementById('editLeadBtn');if(!id||!phone){err.textContent='Phone required';err.classList.remove('hidden');return}btn.disabled=true;btn.textContent='Saving...';fetch('/lead/update',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'XMLHttpRequest'},body:'id='+encodeURIComponent(id)+'&name='+encodeURIComponent(name)+'&phone='+encodeURIComponent(phone)+'&business_name='+encodeURIComponent(biz)+'&notes='+encodeURIComponent(notes?notes.value.trim():'')}).then(function(r){return r.json()}).then(function(d){btn.disabled=false;btn.textContent='💾 Save';if(d.success){alert(d.message);closeEditLeadModal();location.reload()}else{err.textContent=d.message;err.classList.remove('hidden')}}).catch(function(){btn.disabled=false;btn.textContent='💾 Save';err.textContent='Network error';err.classList.remove('hidden')});}
function filterLeads(val){var q=val.toLowerCase().trim();var rows=document.querySelectorAll('.lead-row');var visible=0;rows.forEach(function(r){var search=r.getAttribute('data-search')||'';if(!q||search.indexOf(q)!==-1){r.style.display='';visible++}else{r.style.display='none'}});document.getElementById('noLeadsMsg').classList.toggle('hidden',visible>0);}
// Call History functions
function toggleRecording(id,url){var p=document.getElementById('rec-player-'+id);var btn=document.getElementById('rec-btn-'+id);if(p.classList.contains('hidden')){p.classList.remove('hidden');btn.textContent='🔊 Playing...';p.querySelector('audio').play()}else{p.classList.add('hidden');btn.textContent='🔊 Play Recording';p.querySelector('audio').pause();p.querySelector('audio').currentTime=0}}
function toggleTranscript(id){var t=document.getElementById('transcript-'+id);var btn=document.getElementById('trans-btn-'+id);if(t.classList.contains('hidden')){t.classList.remove('hidden');btn.textContent='📝 Hide Transcript'}else{t.classList.add('hidden');btn.textContent='📝 Show Transcript'}}
function enableNoteEdit(id){document.getElementById('note-view-'+id).classList.add('hidden');document.getElementById('note-edit-'+id).classList.remove('hidden');document.getElementById('note-edit-btn-'+id).classList.add('hidden')}
function cancelNoteEdit(id){document.getElementById('note-view-'+id).classList.remove('hidden');document.getElementById('note-edit-'+id).classList.add('hidden');document.getElementById('note-edit-btn-'+id).classList.remove('hidden')}
function saveNote(id){var val=document.getElementById('note-input-'+id).value.trim();fetch('/call-note/update',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'call_id='+encodeURIComponent(id)+'&notes='+encodeURIComponent(val)}).then(r=>r.json()).then(function(d){if(d.success){document.getElementById('note-text-'+id).textContent=val||'No notes yet.';cancelNoteEdit(id)}else{alert(d.message||'Error saving note')}}).catch(function(){alert('Network error')})}
function deleteNote(id){if(!confirm('Delete this note?'))return;fetch('/call-note/delete',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'call_id='+encodeURIComponent(id)}).then(r=>r.json()).then(function(d){if(d.success){document.getElementById('note-text-'+id).textContent='No notes yet.';cancelNoteEdit(id)}else{alert(d.message||'Error deleting note')}}).catch(function(){alert('Network error')})}
// Number search & buy functions
function searchNumbers(){var ac=document.getElementById('areaCodeInput').value.trim();var city=document.getElementById('cityInput').value.trim().replace(/,/g,'').replace(/\s+/g,' ').trim();var results=document.getElementById('searchResults');var loading=document.getElementById('searchLoading');var error=document.getElementById('searchError');if(!ac&&!city){error.querySelector('p').textContent='Enter an area code or city/state';error.classList.remove('hidden');return}error.classList.add('hidden');loading.classList.remove('hidden');results.classList.add('hidden');var params=ac?'area_code='+encodeURIComponent(ac):'';if(city){if(params)params+='&';if(/^[A-Z]{2}$/i.test(city)){params+='region='+encodeURIComponent(city.toUpperCase())}else{params+='locality='+encodeURIComponent(city)}}fetch('/api/search-numbers?'+params).then(function(r){return r.json()}).then(function(d){loading.classList.add('hidden');if(!d.success){error.querySelector('p').textContent=d.message;error.classList.remove('hidden');return}if(!d.numbers||d.numbers.length===0){error.querySelector('p').textContent='No numbers found';error.classList.remove('hidden');return}renderNumbers(d.numbers,'searchResults');results.classList.remove('hidden')}).catch(function(){loading.classList.add('hidden');error.querySelector('p').textContent='Search failed. Try again.';error.classList.remove('hidden')})}
function buyNum(btn,phone){if(!confirm('Buy '+phone+' for $9.99/month?'))return;btn.disabled=true;btn.textContent='⏳...';var fd=new FormData();fd.append('phone_number',phone);fd.append('email','');fetch('/buy-number',{method:'POST',body:fd}).then(function(r){return r.json()}).then(function(d){if(d.checkout_url){window.location.href=d.checkout_url}else{alert(d.message||'Error');btn.disabled=false;btn.textContent='Buy $9.99/mo'}}).catch(function(){alert('Network error');btn.disabled=false;btn.textContent='Buy $9.99/mo'})}
function purchaseNumber(){if(!confirm('Complete payment for $9.99/month?'))return;fetch('/buy-number',{method:'POST',body:new FormData()}).then(function(r){return r.json()}).then(function(d){if(d.checkout_url)window.location.href=d.checkout_url;else alert(d.message||'Error')}).catch(function(){alert('Network error')})}
function renderNumbers(numbers,targetId){var el=document.getElementById(targetId);if(!el)return;if(!numbers||!numbers.length){el.innerHTML='<div class="text-center py-6 text-[#5c5c70]"><p>No numbers available</p></div>';return}var h='';numbers.forEach(function(n){var loc=[n.locality,n.region].filter(Boolean).join(', ');h+='<div class="flex items-center justify-between p-3 bg-[#1a1a26] rounded-lg mb-2"><div><div class="font-mono text-sm font-bold">'+n.friendly_name+'</div><div class="text-xs text-[#7a7a8e]">'+loc+'</div></div><button data-phone="'+n.phone_number+'" class="buy-btn btn-primary text-xs" style="padding:6px 14px">Buy $9.99/mo</button></div>'});el.innerHTML=h}
function browseNumbers(){var ld=document.getElementById('browseLoading');var res=document.getElementById('browseResults');var btn=document.getElementById('browseBtn');if(ld)ld.classList.remove('hidden');if(btn)btn.disabled=true;fetch('/api/search-numbers?region=FL&limit=10').then(function(r){return r.json()}).then(function(d){if(ld)ld.classList.add('hidden');if(btn)btn.disabled=false;if(d.success&&d.numbers)renderNumbers(d.numbers,'browseResults');else if(res)res.innerHTML='<div class="text-center py-6 text-[#5c5c70]"><p>'+(d.message||'No numbers available')+'</p></div>'}).catch(function(){if(ld)ld.classList.add('hidden');if(btn)btn.disabled=false;var r2=document.getElementById('browseResults');if(r2)r2.innerHTML='<div class="text-center py-6 text-[#5c5c70]"><p>Failed</p></div>'})}
// Event delegation for buy buttons
document.addEventListener('click',function(e){if(e.target&&e.target.classList.contains('buy-btn')){buyNum(e.target,e.target.getAttribute('data-phone'))}});
// Auto-load numbers
if(document.getElementById('browseResults'))setTimeout(browseNumbers,500);
// Knowledge Base generator
function generateKB(type){var btn=document.getElementById(type==='inbound'?'genInboundBtn':'genKBBtn');var status=document.getElementById('kbGenStatus');var ta=document.getElementById('kbTextarea');var scriptTa=document.getElementById('scriptTextarea');btn.disabled=true;btn.textContent='⏳ Generating...';status.textContent='Generating '+type+' knowledge base via AI...';status.style.color='#c084fc';fetch('/api/generate-kb',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({method:'venice',type:type})}).then(function(r){return r.json()}).then(function(d){btn.disabled=false;btn.textContent=type==='inbound'?'📞 AI Generate Inbound KB':'🤖 AI Generate KB';if(d.success){ta.value=d.content;status.textContent='✅ '+d.message;status.style.color='#4ade80';if(scriptTa){var bizName=document.querySelector('h1')?.textContent?.trim()||'Your Business';var scriptContent='You are a professional employee of '+bizName+'. You are a real person — never mention being AI, a robot, or software. You make '+(type==='inbound'?'incoming':'outbound')+' calls. Be professional, concise, and helpful. Use the knowledge base below to answer questions accurately.\n\nKnowledge Base:\n'+d.content;scriptTa.value=scriptContent}}else{status.textContent='❌ '+(d.message||'Generation failed');status.style.color='#ef4444'}}).catch(function(){btn.disabled=false;btn.textContent=type==='inbound'?'📞 AI Generate Inbound KB':'🤖 AI Generate KB';status.textContent='❌ Network error';status.style.color='#ef4444'})}
// Play Voice
function playVoice(voiceId){var text="Hi, this is your AI voice assistant.";var audio=new Audio('/api/test-voice?voice_id='+encodeURIComponent(voiceId)+'&text='+encodeURIComponent(text)+'&speed=1.0&t='+Date.now());audio.play().catch(function(e){console.log('Play failed:',e)});}

// ── KB DOCUMENTS (Settings tab) ──
function kbStatus(msg, ok){var st=document.getElementById('kbDocStatus');if(!st)return;st.textContent=msg;st.style.color=ok?'#4ade80':'#f87171';}
function uploadKbDoc(){
  var inp=document.getElementById('kbFileInput');
  if(!inp||!inp.files.length){kbStatus('⚠️ Choose a file first',false);return;}
  var fd=new FormData();fd.append('file',inp.files[0]);
  kbStatus('⏳ Uploading...',true);
  fetch('/upload-kb-document',{method:'POST',body:fd}).then(function(r){return r.json()}).then(function(d){
    kbStatus(d.message||d.error,d.success);
    if(d.success)setTimeout(function(){location.reload()},1200);
  }).catch(function(e){kbStatus('❌ '+e,false)});
}
function addKbUrl(){
  var inp=document.getElementById('kbUrlInput');
  var url=inp?inp.value.trim():'';
  if(!url){kbStatus('⚠️ Enter a URL first',false);return;}
  kbStatus('⏳ Fetching page...',true);
  fetch('/add-kb-url',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({url:url})}).then(function(r){return r.json()}).then(function(d){
    kbStatus(d.message||d.error,d.success);
    if(d.success)setTimeout(function(){location.reload()},1200);
  }).catch(function(e){kbStatus('❌ '+e,false)});
}
function deleteKbDoc(id){
  fetch('/delete-kb-document',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){kbStatus('🗑️ Deleted',false);setTimeout(function(){location.reload()},600);}
  }).catch(function(e){kbStatus('❌ '+e,false)});
}

// ── LIVE CALLING STATUS (overview tab) ──
var callingInterval = setInterval(refreshCallingStatus, 4000);
var callingFirst = true;

async function refreshCallingStatus() {
  try {
    var r = await fetch('/api/campaign/monitor');
    var d = await r.json();
    updateCallingStatus(d);
  } catch(e) {}
}

function updateCallingStatus(d) {
  var list = document.getElementById('callingLeadsList');
  var badge = document.getElementById('callingCountBadge');
  var dot = document.getElementById('callingLiveDot');
  var label = document.getElementById('callingStatusLabel');
  
  var calling = d.calling_leads || [];
  var running = d.campaign_running && d.thread_alive;
  
  if (calling.length > 0) {
    label.textContent = 'Now Calling';
    badge.textContent = calling.length + ' calling';
    badge.style.background = 'rgba(74,222,128,0.15)';
    badge.style.color = '#4ade80';
    dot.classList.remove('hidden');
    
    var html = '';
    calling.forEach(function(l) {
      var name = l.name || l.business_name || 'Lead';
      var phone = (l.phone || '').slice(0, 14);
      var time = (l.last_called_at || '').slice(11, 19);
      html += '<div class="flex items-center gap-2 p-2 rounded-lg bg-[#1a1a26] border-l-2 border-green-400 animate-pulse">';
      html += '<span class="w-2 h-2 bg-green-400 rounded-full"></span>';
      html += '<span class="font-medium text-green-400">' + name.slice(0, 20) + '</span>';
      html += '<span class="text-[#7a7a8e]">' + phone + '</span>';
      if (time) html += '<span class="text-[#5c5c70] ml-auto text-[10px]">' + time + ' ago</span>';
      html += '</div>';
    });
    list.innerHTML = html;
  } else if (running) {
    label.textContent = 'Waiting for next cycle';
    badge.textContent = d.lead_states?.NEW || 0 + ' pending';
    badge.style.background = 'rgba(251,191,36,0.15)';
    badge.style.color = '#fbbf24';
    dot.classList.add('hidden');
    list.innerHTML = '<div class="text-[#5c5c70] text-center py-3">⏳ Campaign running — waiting for next call cycle</div>';
  } else if (d.campaign && d.campaign.status == 'completed') {
    label.textContent = 'Campaign Complete';
    badge.textContent = '✅ Done';
    badge.style.background = 'rgba(129,140,248,0.15)';
    badge.style.color = '#818cf8';
    dot.classList.add('hidden');
    list.innerHTML = '<div class="text-[#5c5c70] text-center py-3">All leads have been called</div>';
  } else {
    label.textContent = 'Idle';
    badge.textContent = '0 calling';
    badge.style.background = 'rgba(37,37,51,0.5)';
    badge.style.color = '#7a7a8e';
    dot.classList.add('hidden');
    list.innerHTML = '<div class="text-[#5c5c70] text-center py-3">No active campaign. Start one from the Leads tab.</div>';
  }
}

// Stop calling poll when leaving page
document.addEventListener('visibilitychange', function() {
  if (document.hidden) clearInterval(callingInterval);
  else callingInterval = setInterval(refreshCallingStatus, 4000);
});
setTimeout(refreshCallingStatus, 300);
</script>

