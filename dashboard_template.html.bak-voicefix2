<script>
// Auto-refresh campaign monitor every 5 seconds
var monitorInterval = setInterval(refreshMonitor, 5000);
var firstLoad = true;

async function refreshMonitor() {
  try {
    var r = await fetch('/api/campaign/monitor');
    var d = await r.json();
    updateMonitor(d);
  } catch(e) {}
}

function updateMonitor(d) {
  document.getElementById('monTotal').textContent = d.total_leads || 0;
  document.getElementById('monNew').textContent = d.lead_states?.NEW || 0;
  document.getElementById('monCalling').textContent = (d.lead_states?.CALLING||0) + (d.lead_states?.QUEUED||0);
  document.getElementById('monCalled').textContent = (d.lead_states?.CALLED||0) + (d.lead_states?.INTERESTED||0) + (d.lead_states?.NO_ANSWER||0) + (d.lead_states?.NOT_INTERESTED||0);
  
  var statusEl = document.getElementById('monitorStatus');
  var dotEl = document.getElementById('liveDot');
  var camp = d.campaign;
  
  if (d.campaign_running && d.thread_alive) {
    statusEl.textContent = '🔴 RUNNING';
    statusEl.style.background = 'rgba(74,222,128,0.15)';
    statusEl.style.color = '#4ade80';
    dotEl.classList.remove('hidden');
  } else if (camp && camp.status == 'completed') {
    statusEl.textContent = '✅ COMPLETED';
    statusEl.style.background = 'rgba(129,140,248,0.15)';
    statusEl.style.color = '#818cf8';
    dotEl.classList.add('hidden');
  } else if (camp && camp.status == 'stopped') {
    statusEl.textContent = '⏹️ STOPPED';
    statusEl.style.background = 'rgba(239,68,68,0.15)';
    statusEl.style.color = '#ef4444';
    dotEl.classList.add('hidden');
  } else {
    statusEl.textContent = '⏸️ IDLE';
    statusEl.style.background = 'rgba(37,37,51,0.5)';
    statusEl.style.color = '#7a7a8e';
    dotEl.classList.add('hidden');
  }

  // Build log feed
  if (d.logs && d.logs.length > 0) {
    var logHtml = '';
    var maxLogs = 15;
    for (var i = 0; i < Math.min(d.logs.length, maxLogs); i++) {
      var entry = d.logs[i];
      var time = (entry.created_at || '').slice(11, 19);
      var emoji = entry.level == 'success' ? '✅' : entry.level == 'error' ? '❌' : entry.level == 'warning' ? '⚠️' : '📡';
      logHtml += '<div class="monitor-log-entry level-' + entry.level + '">';
      logHtml += '<span class="text-[#5c5c70] mr-2">' + time + '</span>';
      logHtml += '<span>' + emoji + ' ' + (entry.message || '').slice(0, 120) + '</span></div>';
    }
    document.getElementById('monitorLog').innerHTML = logHtml;
  }
}

// Stop refresh when leaving the page
document.addEventListener('visibilitychange', function() {
  if (document.hidden) clearInterval(monitorInterval);
  else monitorInterval = setInterval(refreshMonitor, 5000);
});

// Refresh immediately on page load
setTimeout(refreshMonitor, 500);
</script>

  <!-- ======== TAB: SMS INBOX ======== -->
  {% elif tab == 'sms' %}
  <div class="space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <h3 class="font-bold">💬 SMS Inbox</h3>
        <p class="text-xs text-[#7a7a8e]">Incoming + outgoing messages for your business. Reply or compose right here.</p>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="toggleSavedFilter()" id="savedFilterBtn" class="btn-secondary text-xs" style="padding:6px 14px">⭐ Saved</button>
        <button onclick="openCompose('')" class="btn-primary text-xs" style="padding:6px 14px">✏️ New Message</button>
        <button onclick="refreshInbox()" class="btn-secondary text-xs" style="padding:6px 14px">🔄 Refresh</button>
        <span id="inboxStatus" class="text-xs text-[#7a7a8e]"></span>
      </div>
    </div>
    <div class="card" id="smsInboxCard">
      <div class="text-center py-12 text-[#7a7a8e]">
        <div class="text-4xl mb-3">💬</div>
        <p>Loading SMS inbox...</p>
      </div>
    </div>
  </div>

  <!-- Compose/Reply modal -->
  <div id="smsComposeModal" class="modal" style="display:none;position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.6);align-items:center;justify-content:center">
    <div class="card" style="width:min(520px,92vw);padding:24px">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-bold" id="smsComposeTitle">✏️ New Message</h3>
        <button onclick="closeCompose()" style="background:none;border:none;color:#7a7a8e;font-size:18px;cursor:pointer">✕</button>
      </div>
      <label class="text-xs text-[#7a7a8e] block mb-1">📱 Phone Number</label>
      <input type="text" id="smsComposePhone" placeholder="+1786..." class="mb-3" style="width:100%;padding:10px 12px;border-radius:8px;border:1px solid #252533;background:#0c0c18;color:#f1f1f5">
      <label class="text-xs text-[#7a7a8e] block mb-1">💬 Message</label>
      <textarea id="smsComposeBody" rows="4" placeholder="Type your message..." class="mb-3" style="width:100%;padding:10px 12px;border-radius:8px;border:1px solid #252533;background:#0c0c18;color:#f1f1f5;font-size:13px"></textarea>
      <div class="flex items-center gap-2 justify-end">
        <span id="smsComposeStatus" class="text-xs"></span>
        <button onclick="sendCompose()" class="btn-primary text-xs" style="padding:8px 20px">📤 Send SMS</button>
      </div>
    </div>
  </div>

  <script>
  var inboxInterval = null;
  var savedFilter = false;
  var inboxCache = [];
  function toggleSavedFilter() {
    savedFilter = !savedFilter;
    var btn = document.getElementById('savedFilterBtn');
    if (btn) btn.style.outline = savedFilter ? '2px solid #c084fc' : 'none';
    renderInbox(inboxCache);
  }
  function openCompose(phone) {
    document.getElementById('smsComposePhone').value = phone || '';
    document.getElementById('smsComposeBody').value = '';
    document.getElementById('smsComposeStatus').textContent = '';
    document.getElementById('smsComposeTitle').textContent = phone ? '↩️ Reply to ' + phone : '✏️ New Message';
    var modal = document.getElementById('smsComposeModal');
    modal.style.display = 'flex';
    document.getElementById('smsComposeBody').focus();
  }
  function closeCompose() {
    document.getElementById('smsComposeModal').style.display = 'none';
  }
  function sendCompose() {
    var phone = document.getElementById('smsComposePhone').value.trim();
    var body = document.getElementById('smsComposeBody').value.trim();
    var status = document.getElementById('smsComposeStatus');
    if (!phone || !body) { status.textContent = '⚠️ Phone + message required'; status.style.color = '#fbbf24'; return; }
    status.textContent = '⏳ Sending...'; status.style.color = '#c084fc';
    var fd = new FormData();
    fd.append('phone', phone);
    fd.append('message', body);
    fetch('/api/sms/send', { method: 'POST', body: fd })
      .then(function(r){ return r.json(); })
      .then(function(d){
        if (d.success) {
          status.textContent = '✅ Sent!'; status.style.color = '#4ade80';
          setTimeout(closeCompose, 800);
          setTimeout(refreshInbox, 1200);
        } else {
          status.textContent = '❌ ' + (d.error || 'Send failed'); status.style.color = '#f87171';
        }
      })
      .catch(function(){ status.textContent = '❌ Network error'; status.style.color = '#f87171'; });
  }
  function renderInbox(list) {
    var card = document.getElementById('smsInboxCard');
    var status = document.getElementById('inboxStatus');
    var msgs = list || [];
    if (savedFilter) msgs = msgs.filter(function(m){ return m.saved == 1; });
    if (!msgs.length) {
      var hint = savedFilter ? 'No saved messages. Tap ⭐ on a message to save it.' : 'No SMS yet. Messages to/from your leads appear here. Send one with ✏️ New Message.';
      card.innerHTML = '<div class="text-center py-12 text-[#7a7a8e]"><div class="text-4xl mb-3">📭</div><p class="mb-2">' + (savedFilter ? 'No saved messages.' : 'No SMS yet.') + '</p><p class="text-xs">' + hint + '</p></div>';
      if (status) status.textContent = msgs.length + ' messages';
      return;
    }
    var html = '<div style="overflow-x:auto"><table class="w-full text-sm"><thead><tr style="border-bottom:1px solid #252533">' +
      '<th class="text-left py-3 pr-3 text-[#7a7a8e] text-xs">From / To</th>' +
      '<th class="text-left py-3 pr-3 text-[#7a7a8e] text-xs">Message</th>' +
      '<th class="text-left py-3 pr-3 text-[#7a7a8e] text-xs">Time</th>' +
      '<th class="text-left py-3 pr-3 text-[#7a7a8e] text-xs">Direction</th>' +
      '<th class="text-left py-3 pr-3 text-[#7a7a8e] text-xs">Actions</th>' +
      '</tr></thead><tbody>';
    msgs.forEach(function(m){
      var time = (m.received_at || m.sent_at || '').replace('T', ' ').slice(0, 16);
      var isIn = m.direction === 'IN';
      var fromTo = isIn ? (m.sender || '-') : ('→ ' + (m.phone || m.recipient || '-'));
      var badge = isIn
        ? '<span class="badge badge-success">IN</span>'
        : '<span class="badge">OUT</span>';
      var number = isIn ? (m.sender || '') : (m.phone || m.recipient || '');
      var body = m.body || m.message || '';
      var safeId = (m.id || '').replace(/'/g, "\\'");
      var star = m.saved == 1 ? '⭐' : '☆';
      html += '<tr style="border-bottom:1px solid #1a1a2e"' + (m.saved == 1 ? ' class="bg-yellow-500/5"' : '') + '>' +
        '<td class="py-3 pr-3 font-mono text-xs">' + (fromTo || '-') + '</td>' +
        '<td class="py-3 pr-3 text-sm max-w-md" style="word-break:break-word">' + body + '</td>' +
        '<td class="py-3 pr-3 text-xs text-[#7a7a8e]">' + time + '</td>' +
        '<td class="py-3 pr-3">' + badge + '</td>' +
        '<td class="py-3 pr-3 whitespace-nowrap">' +
          '<button onclick="openCompose(\'' + number.replace(/'/g, "\\'") + '\')" class="btn-secondary text-xs" style="padding:3px 8px;margin-right:4px">↩️</button>' +
          '<button onclick="toggleSave(\'' + safeId + '\',\'' + m.which + '\',' + (m.saved == 1 ? 0 : 1) + ')" title="Save/Unsave" style="background:none;border:none;cursor:pointer;font-size:14px">' + star + '</button> ' +
          '<button onclick="forwardSms(\'' + safeId + '\',\'' + m.which + '\')" title="Forward" style="background:none;border:none;cursor:pointer;font-size:14px">↪️</button> ' +
          '<button onclick="deleteSms(\'' + safeId + '\',\'' + m.which + '\')" title="Delete" style="background:none;border:none;cursor:pointer;font-size:14px">🗑️</button>' +
        '</td>' +
        '</tr>';
    });
    html += '</tbody></table></div>';
    card.innerHTML = html;
    if (status) status.textContent = msgs.length + ' messages';
  }
  function refreshInbox() {
    fetch('/api/inbox').then(function(r){ return r.json(); }).then(function(d){
      inboxCache = d.messages || [];
      renderInbox(inboxCache);
    }).catch(function(){
      document.getElementById('smsInboxCard').innerHTML = '<div class="text-center py-8 text-red-400"><p>Failed to load inbox.</p></div>';
    });
  }
  function toggleSave(id, which, saved) {
    var fd = new FormData();
    fd.append('id', id);
    fd.append('which', which);
    fd.append('saved', saved);
    fetch('/api/sms/save', { method: 'POST', body: fd })
      .then(function(r){ return r.json(); })
      .then(function(d){ if (d.success) refreshInbox(); });
  }
  function deleteSms(id, which) {
    if (!confirm('Delete this message?')) return;
    var fd = new FormData();
    fd.append('id', id);
    fd.append('which', which);
    fetch('/api/sms/delete', { method: 'POST', body: fd })
      .then(function(r){ return r.json(); })
      .then(function(d){ if (d.success) refreshInbox(); });
  }
  function forwardSms(id, which) {
    var found = null;
    inboxCache.forEach(function(m){ if (m.id === id && m.which === which) found = m; });
    if (!found) { refreshInbox(); return; }
    var body = found.body || found.message || '';
    openCompose('');
    document.getElementById('smsComposeTitle').textContent = '↪️ Forward message';
    document.getElementById('smsComposeBody').value = body;
    document.getElementById('smsComposePhone').value = '';
    document.getElementById('smsComposePhone').placeholder = 'Forward to...';
    document.getElementById('smsComposeBody').focus();
  }
  if (window.location.search.indexOf('tab=sms') !== -1) {
    document.addEventListener('DOMContentLoaded', function(){
      refreshInbox();
      inboxInterval = setInterval(refreshInbox, 15000);
    });
  }
  </script>

