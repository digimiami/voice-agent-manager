      <div>
        <label class="text-xs text-[#7a7a8e] block mb-1">📞 Area Code</label>
        <div class="flex gap-2">
          <input type="text" id="areaCodeInput" placeholder="e.g. 305" maxlength="3" class="flex-1" style="background:#1a1a26;border:1px solid #252533;border-radius:8px;padding:8px 12px;color:#f1f1f5;outline:none" oninput="this.value=this.value.replace(/\D/g,'').slice(0,3)">
          <button onclick="searchNumbers()" class="btn-primary text-xs" style="padding:8px 16px">Search</button>
        </div>
      </div>
      <div>
        <label class="text-xs text-[#7a7a8e] block mb-1">🏙️ City or State</label>
        <div class="flex gap-2">
          <input type="text" id="cityInput" placeholder="e.g. Miami or FL" class="flex-1" style="background:#1a1a26;border:1px solid #252533;border-radius:8px;padding:8px 12px;color:#f1f1f5;outline:none">
          <button onclick="searchNumbers()" class="btn-primary text-xs" style="padding:8px 16px">Search</button>
        </div>
      </div>
    </div>

    <!-- Results -->
    <div id="searchResults" class="hidden"></div>
    <div id="searchLoading" class="hidden text-center py-6 text-[#7a7a8e]"><p>🔍 Searching...</p></div>
