  <!-- Landing page JS -->
  <script>
  // ── Toast helper ──
  function showLandingToast(msg, type) {
    var existing = document.getElementById('landingToast');
    if (existing) existing.remove();
    var t = document.createElement('div');
    t.id = 'landingToast';
    t.className = 'fixed top-4 right-4 z-50 px-4 py-3 rounded-lg text-sm font-medium shadow-lg animate-slide-in ' +
      (type === 'error' ? 'bg-red-500/90 text-white' : type === 'success' ? 'bg-green-500/90 text-white' : 'bg-[#252533] text-white');
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(function(){ t.style.opacity = '0'; setTimeout(function(){ t.remove(); }, 300); }, 3500);
  }

  // ── AI Generate ──
  function aiGenerateLanding() {
    var btn = document.getElementById('aiGenBtn');
    var status = document.getElementById('aiGenStatus');
    var result = document.getElementById('aiGenResult');
    btn.disabled = true;
    btn.innerHTML = '⏳ Generating...';
    status.classList.remove('hidden');
    status.textContent = '🤖 AI is crafting your landing page copy...';
    status.style.color = '#c084fc';
    result.classList.add('hidden');
    fetch('/landing/ai-generate', { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        btn.disabled = false;
        btn.innerHTML = '🤖 AI Generate Landing Page';
        if (d.success) {
          status.classList.add('hidden');
          result.classList.remove('hidden');
          showLandingToast('✅ Landing page generated!', 'success');
          setTimeout(function(){ location.reload(); }, 1500);
        } else {
          status.textContent = '❌ ' + (d.message || 'Generation failed');
          status.style.color = '#ef4444';
        }
      })
      .catch(function() {
        btn.disabled = false;
        btn.innerHTML = '🤖 AI Generate Landing Page';
        status.textContent = '❌ Network error. Please try again.';
        status.style.color = '#ef4444';
      });
  }

  // ── Publish / Unpublish ──
  function publishLanding() {
    fetch('/landing/save', { method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded'}, body: 'action=publish' })
      .then(function(r){ return r.json(); })
      .then(function(d){
        if (d.success) { showLandingToast('✅ Landing page published!', 'success'); setTimeout(function(){ location.reload(); }, 1000); }
        else { showLandingToast('❌ ' + (d.message || 'Publish failed'), 'error'); }
      })
      .catch(function(){ showLandingToast('❌ Network error', 'error'); });
  }

  function unpublishLanding() {
    fetch('/landing/unpublish', { method: 'POST' })
      .then(function(r){ return r.json(); })
      .then(function(d){
        if (d.success) { showLandingToast('✅ Landing page unpublished', 'success'); setTimeout(function(){ location.reload(); }, 1000); }
        else { showLandingToast('❌ ' + (d.message || 'Unpublish failed'), 'error'); }
      })
      .catch(function(){ showLandingToast('❌ Network error', 'error'); });
  }

  // ── Save Content ──
  function saveLandingContent(e) {
    e.preventDefault();
    var form = document.getElementById('contentForm');
    var fd = new FormData(form);
    var btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.textContent = '⏳ Saving...';
    fetch('/landing/save', { method: 'POST', body: fd })
      .then(function(r){ return r.json(); })
      .then(function(d){
        btn.disabled = false;
        btn.innerHTML = '💾 Save Content';
        if (d.success) { showLandingToast('✅ Content saved!', 'success'); }
        else { showLandingToast('❌ ' + (d.message || 'Save failed'), 'error'); }
      })
      .catch(function(){
        btn.disabled = false;
        btn.innerHTML = '💾 Save Content';
        showLandingToast('❌ Network error', 'error');
      });
  }

  // ── Save single field (video, audio label) ──
  function saveLandingField(field, value) {
    fetch('/landing/update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: 'field=' + encodeURIComponent(field) + '&value=' + encodeURIComponent(value)
    })
      .then(function(r){ return r.json(); })
      .then(function(d){
        if (d.success) { showLandingToast('✅ ' + field.replace(/_/g,' ') + ' saved!', 'success'); }
        else { showLandingToast('❌ ' + (d.message || 'Save failed'), 'error'); }
      })
      .catch(function(){ showLandingToast('❌ Network error', 'error'); });
  }

  // ── Upload Media ──
  function uploadMedia(type, input) {
    var file = input.files[0];
    if (!file) return;
    var fd = new FormData();
    fd.append('media', file);
    var statusEl = document.getElementById(type + 'UploadStatus');
    statusEl.textContent = '⏳ Uploading...';
    fetch('/landing/upload-media?type=' + encodeURIComponent(type), { method: 'POST', body: fd })
      .then(function(r){ return r.json(); })
      .then(function(d){
        statusEl.textContent = '';
        if (d.success) { showLandingToast('✅ ' + type + ' uploaded!', 'success'); setTimeout(function(){ location.reload(); }, 1000); }
        else { showLandingToast('❌ ' + (d.message || 'Upload failed'), 'error'); }
      })
      .catch(function(){
        statusEl.textContent = '';
        showLandingToast('❌ Upload network error', 'error');
      });
  }

  // ── SEO ──
  function updateSeoCharCount() {
    var ta = document.getElementById('seoDescInput');
    var ct = document.getElementById('seoCharCount');
    ct.textContent = (ta ? ta.value.length : 0) + ' / 160';
  }

  function saveSeoSettings() {
    var title = document.getElementById('seoTitleInput').value;
    var desc = document.getElementById('seoDescInput').value;
    var keywords = document.getElementById('seoKeywordsInput').value;
    fetch('/landing/update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: 'field=seo_settings&seo_title=' + encodeURIComponent(title) + '&meta_description=' + encodeURIComponent(desc) + '&meta_keywords=' + encodeURIComponent(keywords)
    })
      .then(function(r){ return r.json(); })
      .then(function(d){
        if (d.success) { showLandingToast('✅ SEO settings saved!', 'success'); }
        else { showLandingToast('❌ ' + (d.message || 'Save failed'), 'error'); }
      })
      .catch(function(){ showLandingToast('❌ Network error', 'error'); });
  }

  // ── Color picker live preview ──
  document.addEventListener('DOMContentLoaded', function(){
    var pc = document.querySelector('input[name="primary_color"]');
    var sc = document.querySelector('input[name="secondary_color"]');
    if (pc) pc.addEventListener('input', function(){ document.getElementById('primaryColorVal').textContent = this.value; });
    if (sc) sc.addEventListener('input', function(){ document.getElementById('secondaryColorVal').textContent = this.value; });
    updateSeoCharCount();
  });
  </script>

