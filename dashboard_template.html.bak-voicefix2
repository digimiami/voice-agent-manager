  <script>
  var apiKeysLoaded = false;
  function toggleNewKeyForm() {
    var f = document.getElementById('newKeyForm');
    f.classList.toggle('hidden');
    if (!f.classList.contains('hidden')) document.getElementById('newKeyName').focus();
  }
  function closeKeyMessage() {
    document.getElementById('keyGeneratedMessage').classList.add('hidden');
  }
  function copyKey() {
    var el = document.getElementById('newKeyValue');
    var text = el.textContent;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function() {
        el.style.color = '#4ade80';
        setTimeout(function(){ el.style.color = '#a855f7'; }, 2000);
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text; ta.style.position='fixed'; ta.style.opacity='0';
      document.body.appendChild(ta); ta.select(); document.execCommand('copy');
      document.body.removeChild(ta);
    }
  }
  function generateApiKey() {
    var name = document.getElementById('newKeyName').value.trim();
    if (!name) { alert('Please enter a key name'); return; }
    var desc = document.getElementById('newKeyDesc').value.trim();
    var btn = document.querySelector('#newKeyForm .btn-primary');
    btn.disabled = true; btn.textContent = '⏳ Generating...';
    fetch('/api/me/keys/generate', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({name: name, description: desc})
    }).then(function(r){return r.json()}).then(function(d){
      btn.disabled = false; btn.textContent = 'Generate Key';
      if (d.success) {
        document.getElementById('newKeyValue').textContent = d.api_key;
        document.getElementById('keyGeneratedMessage').classList.remove('hidden');
        document.getElementById('newKeyForm').classList.add('hidden');
        document.getElementById('newKeyName').value = '';
        document.getElementById('newKeyDesc').value = '';
        loadApiKeys();
      } else {
        alert(d.error || 'Failed to generate key');
      }
    }).catch(function(){
      btn.disabled = false; btn.textContent = 'Generate Key';
      alert('Network error');
    });
  }
  function loadApiKeys() {
    var container = document.getElementById('apiKeysContainer');
    container.innerHTML = '<div class="text-center py-8 text-[#7a7a8e]"><p>Loading...</p></div>';
    fetch('/api/me/keys').then(function(r){return r.json()}).then(function(d){
      if (!d.keys || d.keys.length === 0) {
        container.innerHTML = '<div class="text-center py-12 text-[#7a7a8e]"><div class="text-4xl mb-3">🔑</div><p class="mb-2">No API keys yet.</p><p class="text-xs">Generate one to let AI agents access your account.</p></div>';
        return;
      }
      var html = '<div style="overflow-x:auto"><table class="w-full text-sm"><thead><tr style="border-bottom:1px solid #252533">' +
        '<th class="text-left py-3 pr-3 text-[#7a7a8e] text-xs">Name</th>' +
        '<th class="text-left py-3 pr-3 text-[#7a7a8e] text-xs">Key</th>' +
        '<th class="text-left py-3 pr-3 text-[#7a7a8e] text-xs">Created</th>' +
        '<th class="text-left py-3 pr-3 text-[#7a7a8e] text-xs">Last Used</th>' +
        '<th class="text-left py-3 pr-3 text-[#7a7a8e] text-xs">Status</th>' +
        '<th class="text-right py-3 text-[#7a7a8e] text-xs">Actions</th>' +
        '</tr></thead><tbody>';
      d.keys.forEach(function(k){
        var status = k.active ? '<span class="text-green-400">● Active</span>' : '<span class="text-red-400">● Revoked</span>';
        var lastUsed = k.last_used_at ? k.last_used_at.slice(0,10) : 'Never';
        var created = k.created_at ? k.created_at.slice(0,10) : '-';
        var actions = '';
        if (k.active) {
          actions = '<button onclick="revokeKey(\''+k.id+'\')" class="text-xs text-red-400 hover:text-red-300 mr-2">Revoke</button>';
        } else {
          actions = '<button onclick="reactivateKey(\''+k.id+'\')" class="text-xs text-green-400 hover:text-green-300 mr-2">Activate</button>';
        }
        actions += '<button onclick="deleteKey(\''+k.id+'\')" class="text-xs text-[#7a7a8e] hover:text-red-400">Delete</button>';
        html += '<tr style="border-bottom:1px solid #1a1a2e">' +
          '<td class="py-3 pr-3 font-medium">' + (k.name || 'Unnamed') + '</td>' +
          '<td class="py-3 pr-3 font-mono text-xs text-[#7a7a8e]">' + (k.raw_prefix || 'dz_...') + '</td>' +
          '<td class="py-3 pr-3 text-xs text-[#7a7a8e]">' + created + '</td>' +
          '<td class="py-3 pr-3 text-xs text-[#7a7a8e]">' + lastUsed + '</td>' +
          '<td class="py-3 pr-3 text-xs">' + status + '</td>' +
          '<td class="py-3 text-xs text-right">' + actions + '</td>' +
          '</tr>';
      });
      html += '</tbody></table></div>';
      container.innerHTML = html;
    }).catch(function(){
      container.innerHTML = '<div class="text-center py-8 text-red-400"><p>Failed to load API keys.</p></div>';
    });
  }
  function revokeKey(id) {
    if (!confirm('Revoke this API key? Agents using it will lose access.')) return;
    fetch('/api/me/keys/' + id + '/revoke', {method: 'POST'})
    .then(function(r){return r.json()}).then(function(d){
      if (d.success) loadApiKeys();
      else alert(d.error || 'Failed');
    }).catch(function(){alert('Network error');});
  }
  function reactivateKey(id) {
    fetch('/api/me/keys/' + id + '/reactivate', {method: 'POST'})
    .then(function(r){return r.json()}).then(function(d){
      if (d.success) loadApiKeys();
    }).catch(function(){});
  }
  function deleteKey(id) {
    if (!confirm('Permanently delete this API key? This cannot be undone.')) return;
    fetch('/api/me/keys/' + id + '/delete', {method: 'DELETE'})
    .then(function(r){return r.json()}).then(function(d){
      if (d.success) loadApiKeys();
      else alert(d.error || 'Failed');
    }).catch(function(){alert('Network error');});
  }
  // Load keys on tab show
  if (window.location.search.indexOf('tab=api-keys') !== -1) {
    document.addEventListener('DOMContentLoaded', loadApiKeys);
  }
  </script>

