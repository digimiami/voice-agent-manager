  {% elif tab == 'landing' %}
  <div class="space-y-6">

    <!-- ── Section 1: AI Generate ── -->
    <div class="card">
      <h3 class="font-bold mb-4">🤖 AI Landing Page Generator</h3>
      <button id="aiGenBtn" onclick="aiGenerateLanding()" class="btn-primary w-full text-lg py-3 flex items-center justify-center gap-2">
        🤖 AI Generate Landing Page
      </button>
      <p id="aiGenStatus" class="text-xs text-[#7a7a8e] mt-2 hidden"></p>
