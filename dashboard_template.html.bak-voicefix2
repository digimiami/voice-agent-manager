  <!-- ======== TAB: PHONE NUMBERS ======== -->
  {% elif tab == 'numbers' %}
  
  <!-- Your Numbers -->
  <div class="card mb-6">
    <h3 class="font-bold mb-4">📱 Your Numbers</h3>
    {% if assigned_numbers %}
    {% for n in assigned_numbers %}
    <div class="flex justify-between items-center p-3 bg-[#1a1a26] rounded-lg mb-2">
      <div>
        <div class="font-mono text-sm font-bold">{{ n.number }}</div>
