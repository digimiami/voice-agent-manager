<!-- MODALS -->
<div id="addLeadModal" class="modal-overlay" onclick="if(event.target===this)closeAddLeadModal()">
  <div class="modal-content">
    <div class="flex justify-between items-center mb-4"><h3 class="font-bold">➕ Add Lead</h3><button onclick="closeAddLeadModal()" class="text-[#5c5c70] hover:text-white" style="font-size:24px;background:none;border:none;cursor:pointer">&times;</button></div>
    <div class="space-y-3">
      <input type="text" id="addLeadModalPhone" placeholder="Phone number *" required>
      <input type="text" id="addLeadModalName" placeholder="Contact name">
      <input type="text" id="addLeadModalBiz" placeholder="Business name">
      <textarea id="addLeadModalNotes" rows="3" placeholder="Knowledge / context about this lead (optional) — e.g. business details, interests, previous conversation, so the AI call is more personalized" style="width:100%;padding:10px 14px;border-radius:8px;border:1px solid #252533;background:#0c0c18;color:#f1f1f5;font-size:13px;resize:vertical;font-family:inherit"></textarea>
      <p id="addLeadModalError" class="hidden text-red-400 text-xs"></p>
    </div>
    <div class="flex gap-2 mt-5"><button onclick="closeAddLeadModal()" class="btn-secondary flex-1">Cancel</button><button id="addLeadModalBtn" onclick="submitAddLeadModal()" class="btn-primary flex-1">+ Add Lead</button></div>
  </div>
