        <a href="{{ c.recording_url }}" target="_blank" download class="btn-secondary text-xs" style="padding:4px 10px;text-decoration:none">⬇️ Download</a>
        {% else %}
        <span class="text-xs text-[#5c5c70]">🔇 No recording</span>
        {% endif %}
        {% if c.transcript %}
        <button onclick="toggleTranscript('{{ c.id }}')" class="btn-secondary text-xs" id="trans-btn-{{ c.id }}" style="padding:4px 10px">📝 Show Transcript</button>
        <a href="data:text/plain;charset=utf-8,{{ (c.transcript or '')|urlencode }}" download="transcript-{{ c.id[:8] }}.txt" class="btn-secondary text-xs" style="padding:4px 10px;text-decoration:none">⬇️ Transcript</a>
        {% endif %}
      </div>

      <!-- Recording audio player (hidden) -->
      <div id="rec-player-{{ c.id }}" class="hidden mb-3">
        <audio controls style="width:100%;max-width:400px;height:36px" preload="none">
          <source src="{{ c.recording_url }}" type="audio/mpeg">
        </audio>
      </div>

      <!-- Transcript (hidden) -->
      <div id="transcript-{{ c.id }}" class="hidden mb-3 p-3 rounded-lg" style="background:#12121a;border:1px solid #252533">
        <pre class="text-xs text-[#d1d1d5] whitespace-pre-wrap leading-relaxed" style="font-family:inherit;max-height:200px;overflow-y:auto">{{ c.transcript or '' }}</pre>
      </div>

      <!-- Notes -->
      <div class="border-t border-[#252533] pt-3 mt-1">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-xs font-semibold text-[#c084fc]">📝 Notes</span>
          <button onclick="enableNoteEdit('{{ c.id }}')" class="text-[10px] text-[#7a7a8e] hover:text-[#c084fc]" style="background:none;border:none;cursor:pointer" id="note-edit-btn-{{ c.id }}">✏️ Edit</button>
        </div>
        <div id="note-view-{{ c.id }}">
          <p class="text-xs text-[#d1d1d5] leading-relaxed" id="note-text-{{ c.id }}">{{ c.notes or 'No notes yet.' }}</p>
        </div>
        <div id="note-edit-{{ c.id }}" class="hidden">
          <textarea id="note-input-{{ c.id }}" rows="2" class="w-full text-xs mb-2" style="background:#12121a;border:1px solid #252533;border-radius:8px;padding:8px;color:#f1f1f5;outline:none;resize:vertical">{{ c.notes or '' }}</textarea>
          <div class="flex gap-2">
            <button onclick="saveNote('{{ c.id }}')" class="btn-primary text-xs" style="padding:4px 12px">💾 Save</button>
            <button onclick="cancelNoteEdit('{{ c.id }}')" class="btn-secondary text-xs" style="padding:4px 12px">Cancel</button>
            {% if c.notes %}
            <button onclick="deleteNote('{{ c.id }}')" class="text-red-400 text-xs" style="padding:4px 12px;background:none;border:1px solid rgba(248,113,113,0.3);border-radius:8px;cursor:pointer">🗑️ Delete</button>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
    {% endfor %}
    </div>
    {% else %}<div class="text-center py-10 text-[#5c5c70]"><p>No call logs yet.</p></div>{% endif %}
  </div>

  <!-- ======== TAB: FOLLOW-UPS ======== -->
  {% elif tab == 'followups' %}
  <div class="card">
    <div class="flex justify-between items-center mb-4 flex-wrap gap-2">
      <h3 class="font-bold">🔄 Follow-ups Needed</h3>
      <div class="flex gap-2">
        <button onclick="callAllFollowups()" class="btn-primary text-xs">📞 Call All Now</button>
        <button onclick="callScheduledFollowups()" class="btn-secondary text-xs">⏰ Call Scheduled</button>
      </div>
    </div>
    {% if followups %}
    <table>
      <thead><tr><th>Name</th><th>Phone</th><th>Status</th><th>Last Called</th><th>Schedule</th><th>Notes</th><th>Action</th></tr></thead>
