  <script>
  function buyMinutes(amount) {
    var prices = {500: 150, 1000: 290, 5000: 490};
    if (!confirm('Add ' + amount + ' minutes ($' + prices[amount] + ') to your account?')) return;
    var btn = event.target;
    btn.disabled = true;
    btn.textContent = '⏳ Processing...';
    var result = document.getElementById('buyResult');
    result.className = 'mt-3 p-3 rounded-lg text-xs hidden';
    fetch('/api/buy-minutes', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({minutes: amount, price: prices[amount]})
    }).then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.success && d.checkout_url) {
        window.location.href = d.checkout_url;
      } else if (d.success) {
        result.className = 'mt-3 p-3 rounded-lg text-xs';
        result.style.background = '#22c55e15';
        result.style.border = '1px solid #22c55e30';
        result.style.color = '#4ade80';
        result.innerHTML = '✅ ' + amount + ' minutes added! <a href="/?tab=billing" class="underline">Refresh</a>';
        result.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = amount + ' min — $' + prices[amount];
      } else {
        result.className = 'mt-3 p-3 rounded-lg text-xs';
        result.style.background = '#ef444415';
        result.style.border = '1px solid #ef444430';
        result.style.color = '#ef4444';
        result.innerHTML = '❌ ' + (d.error || 'Failed');
        result.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = amount + ' min — $' + prices[amount];
      }
    }).catch(function() {
      result.className = 'mt-3 p-3 rounded-lg text-xs';
      result.style.background = '#ef444415';
      result.style.border = '1px solid #ef444430';
      result.style.color = '#ef4444';
      result.innerHTML = '❌ Network error';
      result.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = amount + ' min — $' + prices[amount];
    });
  }
  // Handle Stripe success redirect
  (function() {
    var params = new URLSearchParams(window.location.search);
    if (params.get('stripe') === 'success') {
      var min = params.get('minutes');
      var result = document.getElementById('buyResult');
      if (result) {
        result.className = 'mt-3 p-3 rounded-lg text-xs';
        result.style.background = '#22c55e15';
        result.style.border = '1px solid #22c55e30';
        result.style.color = '#4ade80';
        result.innerHTML = '✅ Payment successful!' + (min ? ' ' + min + ' extra minutes added!' : '') + ' <a href="/?tab=billing" class=\"underline\">Refresh</a>';
        result.classList.remove('hidden');
      }
    }
    if (params.get('stripe') === 'cancel') {
      var result = document.getElementById('buyResult');
      if (result) {
        result.className = 'mt-3 p-3 rounded-lg text-xs';
        result.style.background = '#ef444415';
        result.style.border = '1px solid #ef444430';
        result.style.color = '#ef4444';
        result.innerHTML = '❌ Payment cancelled. No charges were made.';
        result.classList.remove('hidden');
      }
    }
  })();
  function createCheckout() {
    fetch('/create-checkout-session', {method: 'POST'})
    .then(function(r) { return r.json(); })
    .then(function(d) { if (d.url) window.location.href = d.url; else alert(d.error || 'Failed'); })
    .catch(function() { alert('Network error'); });
  }
  </script>
  
