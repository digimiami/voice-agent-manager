<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<!-- GSC_META -->
<script>(function(){fetch('/api/ga-config').then(function(r){return r.json()}).then(function(d){if(d&&d.sc_key){var m=document.createElement('meta');m.name='google-site-verification';m.content=d.sc_key;document.head.appendChild(m)}if(d&&d.ga_id&&d.ga_id.indexOf('G-')===0){var s=document.createElement('script');s.src='https://www.googletagmanager.com/gtag/js?id='+d.ga_id;s.async=true;document.head.appendChild(s);window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',d.ga_id)}}).catch(function(){})})();</script>
<title>{{ biz_name }} - Diazites Dashboard</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*{font-family:'Inter',sans-serif;margin:0;padding:0;box-sizing:border-box}
body{background:#08080f;color:#f1f1f5;overflow-x:hidden}
.gradient-text{background:linear-gradient(135deg,#a855f7,#ec4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.sidebar{width:220px;background:#0c0c18;border-right:1px solid #1a1a2e;height:100vh;position:fixed;left:0;top:0;overflow-y:auto;z-index:40;padding:20px 12px}
.main-content{margin-left:220px;min-height:100vh;padding:24px 32px}
.nav-item{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:10px;color:#7a7a8e;font-size:0.875rem;transition:all 0.2s;text-decoration:none;cursor:pointer}
.nav-item:hover{background:rgba(168,85,247,0.1);color:#f1f1f5}
.nav-item.active{background:rgba(168,85,247,0.15);color:#a855f7;font-weight:600}
.card{background:#12121a;border:1px solid #252533;border-radius:16px;padding:20px;transition:all 0.2s}
.card:hover{border-color:rgba(168,85,247,0.2)}
.stat-value{font-size:1.8rem;font-weight:800;background:linear-gradient(135deg,#a855f7,#ec4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.badge{padding:3px 10px;border-radius:999px;font-size:0.7rem;font-weight:600}
.badge-success{background:rgba(74,222,128,0.15);color:#4ade80}
.badge-warning{background:rgba(251,191,36,0.15);color:#fbbf24}
.badge-error{background:rgba(248,113,113,0.15);color:#f87171}
.badge-info{background:rgba(56,189,248,0.15);color:#38bdf8}
.btn-primary{background:linear-gradient(135deg,#a855f7,#ec4899);color:white;padding:8px 18px;border-radius:8px;font-weight:600;font-size:0.85rem;border:none;cursor:pointer;transition:all 0.2s;display:inline-flex;align-items:center;gap:6px}
.btn-primary:hover{box-shadow:0 4px 15px rgba(168,85,247,0.3)}
.btn-secondary{background:#1a1a26;color:#f1f1f5;padding:8px 18px;border-radius:8px;font-weight:600;font-size:0.85rem;border:1px solid #252533;cursor:pointer;transition:all 0.2s;display:inline-flex;align-items:center;gap:6px}
.btn-secondary:hover{border-color:#a855f7}
input,select,textarea{background:#1a1a26;border:1px solid #252533;border-radius:8px;padding:8px 12px;color:#f1f1f5;outline:none;font-size:0.85rem;transition:border-color 0.2s;width:100%}
input:focus,select:focus,textarea:focus{border-color:#a855f7}
table{width:100%;border-collapse:collapse}
th{color:#7a7a8e;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.5px;text-align:left;padding-bottom:12px;font-weight:600}
td{padding:10px 0;border-bottom:1px solid #1a1a2e;font-size:0.85rem}
tr:last-child td{border-bottom:none}
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:#0c0c18}
::-webkit-scrollbar-thumb{background:#252533;border-radius:3px}
.modal-overlay{position:fixed;inset:0;z-index:50;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,0.6);backdrop-filter:blur(4px)}
.modal-overlay.show{display:flex}
.modal-content{background:#12121a;border:1px solid #252533;border-radius:16px;padding:24px;width:100%;max-width:420px;margin:16px}
.flash{position:fixed;top:20px;right:20px;z-index:100;padding:12px 20px;border-radius:12px;font-size:13px;font-weight:500;animation:slideIn 0.3s}
@keyframes slideIn{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}
.flash-success{background:rgba(74,222,128,0.15);border:1px solid rgba(74,222,128,0.3);color:#4ade80}
.flash-error{background:rgba(248,113,113,0.15);border:1px solid rgba(248,113,113,0.3);color:#f87171}
.flash-info{background:rgba(59,130,246,0.15);border:1px solid rgba(59,130,246,0.3);color:#60a5fa}

/* ── MOBILE RESPONSIVE ── */

/* Hamburger menu button - hidden on desktop */
.mobile-menu-btn {
  display: none;
  background: none;
  border: none;
  color: #f1f1f5;
  font-size: 1.5rem;
  cursor: pointer;
  padding: 4px 8px;
  z-index: 45;
  position: fixed;
  top: 12px;
  left: 12px;
}

/* Sidebar overlay backdrop */
.sidebar-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 39;
}

@media (max-width: 768px) {
  /* Show hamburger on mobile */
  .mobile-menu-btn { display: flex; align-items: center; justify-content: center; }
  
  /* Sidebar slides in from left when open */
  .sidebar {
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    z-index: 40;
    width: 260px;
  }
  .sidebar.open { transform: translateX(0); }
  
  /* Main content - full width on mobile */
  .main-content {
    margin-left: 0 !important;
    padding: 16px 12px !important;
    padding-top: 56px !important;
  }
  
  /* Mobile header spacing */
  .main-content > .flex:first-child {
    flex-direction: column;
    align-items: flex-start !important;
    gap: 4px;
    margin-bottom: 16px !important;
  }
  
  /* Stack stats grid */
  .grid.grid-cols-2 {
    grid-template-columns: 1fr 1fr !important;
  }
  .grid.grid-cols-3 {
    grid-template-columns: 1fr !important;
  }
  .grid.grid-cols-4, .grid.md\\:grid-cols-4 {
    grid-template-columns: 1fr 1fr !important;
  }
  .grid-cols-5 {
    grid-template-columns: 1fr 1fr 1fr !important;
  }
  
  /* Full-width cards on mobile */
  .card {
    padding: 14px !important;
  }
  
  /* Tables - scroll horizontally within card, not page */
  table {
    display: block;
    overflow-x: auto;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
  }
  
  /* Wrap flex items on mobile */
  .flex-wrap {
    gap: 6px !important;
  }
  
  .btn-primary, .btn-secondary, button[class*="px-6"] {
    padding: 8px 14px !important;
    font-size: 0.8rem !important;
  }
  
  /* Stats number sizing */
  .stat-value {
    font-size: 1.4rem !important;
  }
  
  /* Modal on mobile */
  .modal-content {
    margin: 8px !important;
    padding: 16px !important;
  }
  
  /* Max-width containers */
  .max-w-2xl, .max-w-3xl, .max-w-4xl, .max-w-5xl, .max-w-6xl, .max-w-7xl {
    max-width: 100% !important;
  }

  /* Buy minutes buttons - stack on mobile */
  .card .flex.gap-3.flex-wrap > button,
  .card .flex.gap-3.flex-wrap > a {
    flex: 1;
    min-width: 120px;
    text-align: center;
    font-size: 0.8rem !important;
    padding: 10px 8px !important;
  }

  /* Feature badges - smaller on mobile */
  .feature-badge, .inline-flex.items-center.gap-1 {
    font-size: 0.65rem !important;
    padding: 2px 8px !important;
  }

  /* Call history / conversations */
  .text-\[0\.7rem\] {
    font-size: 0.6rem !important;
  }
}

@media (max-width: 480px) {
  .grid.grid-cols-2, .grid.md\\:grid-cols-4 {
    grid-template-columns: 1fr !important;
  }
  .stat-value {
    font-size: 1.2rem !important;
  }
  .main-content {
    padding: 10px 8px !important;
    padding-top: 50px !important;
  }
  h2.text-xl {
    font-size: 1.1rem !important;
  }
  h3.text-lg {
    font-size: 0.95rem !important;
  }
}
</style>
</head>
<body>

<!-- SIDEBAR -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>
<button class="mobile-menu-btn" onclick="toggleSidebar()">☰</button>
<script>
function toggleSidebar() {
  document.querySelector(".sidebar").classList.toggle("open");
  document.getElementById("sidebarOverlay").style.display = 
    document.querySelector(".sidebar").classList.contains("open") ? "block" : "none";
}
// Close sidebar when clicking a nav link on mobile
document.querySelectorAll(".sidebar a").forEach(function(a) {
  a.addEventListener("click", function() {
    if (window.innerWidth <= 768) {
      document.querySelector(".sidebar").classList.remove("open");
      document.getElementById("sidebarOverlay").style.display = "none";
    }
  });
});
</script>
<div class="sidebar">
  <div class="flex items-center gap-2 mb-8 px-2">
    <span class="text-xl">🎙️</span>
    <div>
      <div class="font-bold text-sm gradient-text">Diazites</div>
      <div class="text-[10px] text-[#5c5c70]">{{ biz_name[:20] }}</div>
    </div>
  </div>
  
  <nav class="space-y-1">
    <a href="/?tab=overview" class="nav-item {% if tab == 'overview' %}active{% endif %}"><span>📊</span> Overview</a>
    <a href="/?tab=leads" class="nav-item {% if tab == 'leads' %}active{% endif %}"><span>📋</span> Leads</a>
    <a href="/?tab=sms" class="nav-item {% if tab == 'sms' %}active{% endif %}"><span>💬</span> SMS Inbox</a>
    <a href="/?tab=calls" class="nav-item {% if tab == 'calls' %}active{% endif %}"><span>📞</span> Call History</a>
    <a href="/?tab=followups" class="nav-item {% if tab == 'followups' %}active{% endif %}"><span>🔄</span> Follow-ups</a>
    <a href="/?tab=numbers" class="nav-item {% if tab == 'numbers' %}active{% endif %}"><span>📱</span> Phone Numbers</a>
    <a href="/?tab=agents" class="nav-item {% if tab == 'agents' %}active{% endif %}"><span>🤖</span> Agents</a>
    <a href="/?tab=settings" class="nav-item {% if tab == 'settings' %}active{% endif %}"><span>⚙️</span> Settings</a>
    <a href="/?tab=landing" class="nav-item {% if tab == 'landing' %}active{% endif %}"><span>🌐</span> Landing Page</a>
    <a href="/?tab=calendar" class="nav-item {% if tab == 'calendar' %}active{% endif %}"><span>📅</span> Calendar</a>
    <a href="/?tab=billing" class="nav-item {% if tab == 'billing' %}active{% endif %}"><span>💳</span> Billing</a>
    <a href="/?tab=api-keys" class="nav-item {% if tab == 'api-keys' %}active{% endif %}"><span>🔑</span> API</a>
  </nav>
  
  <div class="absolute bottom-4 left-4 right-4">
    <a href="/logout" class="nav-item text-red-400/60 hover:text-red-400"><span>🚪</span> Logout</a>
  </div>
</div>

<!-- MAIN CONTENT -->
<div class="main-content">

  <!-- Header -->
  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-2xl font-bold">
        {% if tab == 'overview' %}📊 Overview
        {% elif tab == 'leads' %}📋 Leads
        {% elif tab == 'sms' %}💬 SMS Inbox
        {% elif tab == 'calls' %}📞 Call History
        {% elif tab == 'followups' %}🔄 Follow-ups
        {% elif tab == 'numbers' %}📱 Phone Numbers
        {% elif tab == 'agents' %}🤖 Agents
        {% elif tab == 'settings' %}⚙️ Settings
        {% elif tab == 'landing' %}🌐 Landing Page
        {% elif tab == 'calendar' %}📅 Calendar
        {% elif tab == 'billing' %}💳 Billing
        {% elif tab == 'api-keys' %}🔑 API Keys
        {% endif %}
      </h1>
    </div>
    <div class="text-sm text-[#7a7a8e]">{{ biz_name }}</div>
  </div>

  <!-- FLASH MESSAGES -->
  {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
      {% for category, message in messages %}
      <div class="flash flash-{{ category or 'info' }}">{{ message }}</div>
      {% endfor %}
    {% endif %}
  {% endwith %}

  <!-- ======== TAB: OVERVIEW ======== -->
  {% if tab == 'overview' %}
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="card text-center"><div class="stat-value">{{ stats.calls_made or 0 }}</div><div class="text-xs text-[#7a7a8e] mt-1">📞 Calls Made</div></div>
    <div class="card text-center"><div class="stat-value">{{ stats.appointments or 0 }}</div><div class="text-xs text-[#7a7a8e] mt-1">📅 Appointments</div></div>
    <div class="card text-center"><div class="stat-value">{{ stats.leads_total or 0 }}</div><div class="text-xs text-[#7a7a8e] mt-1">📋 Total Leads</div></div>
  </div>

  <!-- Live Calling Status -->
  <div class="card mb-6" id="liveCallingCard">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-sm"><i class="fas fa-phone-volume text-green-400 mr-1"></i> 📞 <span id="callingStatusLabel">Calling Status</span></h3>
      <div class="flex items-center gap-2">
        <span id="callingCountBadge" class="text-xs px-2 py-0.5 rounded-full bg-[#252533] text-[#7a7a8e]">0 calling</span>
        <span id="callingLiveDot" class="hidden w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
      </div>
    </div>
    <div id="callingLeadsList" class="space-y-1 text-xs">
      <div class="text-[#5c5c70] text-center py-3">Checking campaign status...</div>
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-6">
    <div class="card">
      <h3 class="font-bold mb-3">🚀 Campaign Status</h3>
      {% if campaign_status == 'running' %}
        <div class="flex items-center gap-2 text-green-400 mb-3"><span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span><span class="font-semibold">Active</span></div>
        {% set leads_new = stats.leads_new or 0 %}
        {% if leads_new > 0 %}<p class="text-sm text-[#7a7a8e] mb-3">{{ leads_new }} NEW leads remaining</p>{% endif %}
        <a href="/?tab=overview" class="btn-primary text-xs">▶ Running...</a>
      {% elif campaign_status == 'completed' %}
        <div class="text-[#7a7a8e] mb-3">Campaign completed</div>
        <form method="POST" action="/campaign/start" class="inline"><button type="submit" class="btn-secondary text-xs">▶ Restart Campaign</button></form>
      {% else %}
        <div class="text-[#7a7a8e] mb-3">No active campaign</div>
        <form method="POST" action="/campaign/start" onsubmit="return confirm('Start calling leads now?')" class="inline"><button type="submit" class="btn-primary text-xs">▶ Start Campaign</button></form>
      {% endif %}
      <div class="mt-4 text-xs text-[#5c5c70]">Leads: {{ stats.leads_new or 0 }} new / {{ stats.leads_called or 0 }} called</div>
    </div>

    <div class="card">
      <h3 class="font-bold mb-3">📅 Smart Actions</h3>
      <div class="flex flex-wrap gap-2">
        <a href="/?tab=leads" class="btn-secondary text-xs">📤 Upload Leads</a>
        <form method="POST" action="/campaign/start" onsubmit="return confirm('Start calling leads now?')" class="inline"><button type="submit" class="btn-primary text-xs">▶ Start Campaign</button></form>
        <a href="/?tab=settings" class="btn-secondary text-xs">⚙️ Settings</a>
      </div>
    </div>
  </div>

  <!-- Campaign Schedule Card -->
  <div class="card mt-6">
    <h3 class="font-bold mb-3">⏰ Campaign Schedule</h3>
    <form method="POST" action="/campaign/schedule" class="space-y-3">
      <label class="flex items-center gap-2 text-sm cursor-pointer">
        <input type="checkbox" name="schedule_enabled" value="1" {% if schedule and schedule.enabled %}checked{% endif %} onchange="this.form.submit()">
        <span>Enable scheduled calling</span>
      </label>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div>
          <label class="text-xs text-[#7a7a8e] block mb-1">Start Date</label>
          <input type="date" name="schedule_start_date" value="{{ schedule.start_date if schedule else '' }}" class="w-full text-xs">
        </div>
        <div>
          <label class="text-xs text-[#7a7a8e] block mb-1">Start Time</label>
          <input type="time" name="schedule_time" value="{{ schedule.time if schedule else '09:00' }}" class="w-full text-xs">
        </div>
        <div>
          <label class="text-xs text-[#7a7a8e] block mb-1">Timezone</label>
          <select name="timezone" class="w-full text-xs">
            <option value="America/New_York" {% if schedule and schedule.timezone == 'America/New_York' %}selected{% endif %}>Eastern</option>
            <option value="America/Chicago" {% if schedule and schedule.timezone == 'America/Chicago' %}selected{% endif %}>Central</option>
            <option value="America/Denver" {% if schedule and schedule.timezone == 'America/Denver' %}selected{% endif %}>Mountain</option>
            <option value="America/Los_Angeles" {% if schedule and schedule.timezone == 'America/Los_Angeles' %}selected{% endif %}>Pacific</option>
          </select>
        </div>
      </div>
      <div>
        <label class="text-xs text-[#7a7a8e] block mb-1">Call Days</label>
        <div class="flex flex-wrap gap-2 text-xs">
          {% set sched_days = (schedule.days if schedule else 'mon,tue,wed,thu,fri').split(',') %}
          {% for d in [('mon','Mon'),('tue','Tue'),('wed','Wed'),('thu','Thu'),('fri','Fri'),('sat','Sat'),('sun','Sun')] %}
          <label class="flex items-center gap-1 cursor-pointer">
            <input type="checkbox" name="days" value="{{ d[0] }}" {% if d[0] in sched_days %}checked{% endif %}>
            <span>{{ d[1] }}</span>
          </label>
          {% endfor %}
        </div>
      </div>
      <button type="submit" class="btn-primary text-xs">💾 Save Schedule</button>
    </form>
    {% if schedule and schedule.enabled %}
    <div class="mt-3 text-xs text-[#4ade80]">
      ✅ Schedule active: {{ schedule.time if schedule else '09:00' }} on {{ schedule.days if schedule else 'weekdays' }}{% if schedule and schedule.start_date %} from {{ schedule.start_date[:10] }}{% endif %}
    </div>
    {% endif %}
  </div>

  <div class="card mt-6">
    <h3 class="font-bold mb-3">📞 Recent Calls</h3>
    {% if recent_calls %}
    <table>
      <thead><tr><th>Phone</th><th>Outcome</th><th>Duration</th><th>Time</th></tr></thead>
      <tbody>{% for c in recent_calls[:8] %}
        <tr>
          <td class="font-mono text-xs">{{ (c.phone or '')[:14] }}</td>
          <td>{% if c.outcome == 'appointment_booked' %}<span class="badge badge-success">📅 Booked</span>{% elif c.outcome == 'completed' %}<span class="badge badge-info">✅ Done</span>{% elif c.outcome == 'no_answer' %}<span class="badge badge-error">📵 No Ans</span>{% elif c.outcome == 'voicemail' %}<span class="badge badge-warning">📠 VM</span>{% else %}<span class="badge badge-warning">{{ (c.outcome or 'called')[:12] }}</span>{% endif %}</td>
          <td class="text-xs text-[#7a7a8e]">{{ c.duration or 0 }}s</td>
          <td class="text-xs text-[#7a7a8e]">{{ (c.created_at or '')[:16] }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<p class="text-sm text-[#5c5c70]">No calls yet. Start a campaign!</p>{% endif %}
  </div>

  <!-- ======== TAB: LEADS ======== -->
  {% elif tab == 'leads' %}
  <div class="flex gap-3 mb-6 flex-wrap items-center">
    {% if campaign_status == 'running' %}
    <form method="POST" action="/campaign/stop" onsubmit="return confirm('Stop campaign?')"><button type="submit" class="btn-danger text-xs" style="background:#ef4444;color:white;padding:8px 16px;border-radius:8px;font-weight:600;border:none;cursor:pointer;font-size:12px">⏹ Stop Campaign</button></form>
    {% else %}
    <form method="POST" action="/campaign/start" onsubmit="return confirm('Start calling leads now?')"><button type="submit" class="btn-primary text-xs">▶ Start Campaign</button></form>
    {% endif %}
    <button onclick="showAddLeadModal()" class="btn-secondary text-xs">+ Add Lead</button>
    <form method="POST" action="/upload-leads" enctype="multipart/form-data" id="csvUploadForm" class="inline" style="display:inline-flex;align-items:center;gap:6px">
      <label for="csvInput" class="btn-secondary text-xs" style="cursor:pointer;padding:8px 14px;margin:0">📤 Choose CSV</label>
      <input type="file" name="csv" id="csvInput" accept=".csv" style="position:fixed;left:-9999px;top:-9999px;opacity:0;width:1px;height:1px" onchange="var f=this.files[0];if(f){document.getElementById('csvFileName').textContent=f.name;this.form.requestSubmit?this.form.requestSubmit():this.form.submit()}">
      <span id="csvFileName" class="text-xs text-[#7a7a8e]">No file chosen</span>
    </form>
    <a href="/static/lead_template.csv" download class="btn-secondary text-xs">📄 CSV Template</a>
    <form method="POST" action="/campaign/reset" onsubmit="return confirm('Reset campaign counters?')" class="inline"><button type="submit" class="btn-secondary text-xs">🔄 Reset</button></form>
    <input type="text" id="leadSearch" placeholder="🔍 Search by name, phone, or business..." style="width:260px;max-width:100%;margin-left:auto" oninput="filterLeads(this.value)">
  </div>

  <div class="card">
    <h3 class="font-bold mb-3">All Leads ({{ stats.leads_total }})</h3>
    {% if leads %}
    <table id="leadsTable">
      <thead><tr><th>Name</th><th>Phone</th><th>Business</th><th>Status</th><th>Added</th><th>Actions</th></tr></thead>
      <tbody>
      {% for lead in leads %}
      <tr class="lead-row" data-search="{{ (lead.name or '').lower() }} {{ (lead.business_name or '').lower() }} {{ (lead.phone or '') }}">
        <td class="font-medium">{{ lead.name or lead.business_name or 'Prospect' }}{% if lead.notes and lead.notes.strip() %} <span class="text-xs text-[#a855f7]" title="Has context knowledge">📝</span>{% endif %}</td>
        <td class="font-mono text-xs">{{ (lead.phone or '')[:16] }}</td>
        <td class="text-xs text-[#7a7a8e]">{{ lead.business_name or '-' }}</td>
