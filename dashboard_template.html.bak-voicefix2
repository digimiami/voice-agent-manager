        <button onclick="browseNumbers()" class="btn-secondary text-xs" id="browseBtn" style="padding:4px 12px">🔄 Refresh</button>
      </div>
      <div id="browseLoading" class="text-center py-3 text-[#7a7a8e]"><p>🔍 Loading available numbers...</p></div>
      <div id="browseResults"></div>
    </div>
  </div>

  <!-- ======== TAB: AGENTS ======== -->
  {% elif tab == 'agents' %}
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold">🤖 AI Agents</h2>
      <button onclick="showCreateAgent()" class="btn-primary text-xs" id="addAgentBtn">+ New Agent</button>
    </div>
    <p class="text-xs text-[#7a7a8e] mb-4">Each agent has its own phone number, voice, script, and knowledge base.</p>

    <!-- Plan limit meter -->
    <div id="agentLimitBar" class="card mb-4 p-3 hidden">
      <div class="text-xs flex justify-between mb-1">
        <span id="agentCountLabel">Agents: 0</span>
        <span id="agentMaxLabel">Max: 0</span>
      </div>
      <div class="h-2 bg-[#1a1a28] rounded-full overflow-hidden">
        <div id="agentProgressBar" class="h-full rounded-full transition-all" style="width:0%;background:linear-gradient(135deg,#a855f7,#ec4899)"></div>
      </div>
    </div>

    <!-- Agent list -->
    <div id="agentsLoading" class="text-center py-8 text-[#7a7a8e]">🔍 Loading agents...</div>
    <div id="agentsList"></div>

    <!-- Create/Edit Agent Modal -->
    <div id="agentModal" class="fixed inset-0 z-50 hidden flex items-center justify-center" style="background:rgba(0,0,0,0.7)">
      <div class="bg-[#111118] rounded-2xl w-full max-w-2xl mx-4 max-h-[90vh] overflow-y-auto p-6 border border-[#252533]">
        <div class="flex justify-between items-center mb-4">
          <h3 class="font-bold" id="agentModalTitle">🤖 New Agent</h3>
          <button onclick="closeAgentModal()" class="text-[#5c5c70] hover:text-white text-lg">&times;</button>
        </div>
        <input type="hidden" id="editAgentId" value="">

        <div class="space-y-3">
          <div>
            <label class="text-xs text-[#7a7a8e] mb-1 block">Agent Name</label>
            <input id="agentName" class="w-full px-3 py-2 bg-[#1a1a28] rounded-lg border border-[#252533] text-xs" placeholder="e.g. Sales Agent, Support Agent">
          </div>
          <div>
            <label class="text-xs text-[#7a7a8e] mb-1 block">Phone Number</label>
            <select id="agentPhone" class="w-full px-3 py-2 bg-[#1a1a28] rounded-lg border border-[#252533] text-xs">
              <option value="">— Use business default —</option>
              {% for n in assigned_numbers %}
              <option value="{{ n.number }}">{{ n.number }}</option>
              {% endfor %}
            </select>
          </div>
          <div>
            <label class="text-xs text-[#7a7a8e] mb-1 block">Voice</label>
            <select id="agentVoice" class="w-full px-3 py-2 bg-[#1a1a28] rounded-lg border border-[#252533] text-xs">
              <option value="">— Default —</option>
              {% for v in voices %}
              <option value="{{ v.id }}">{{ v.name }}</option>
              {% endfor %}
            </select>
          </div>
          <div>
            <label class="text-xs text-[#7a7a8e] mb-1 block">Voice Speed</label>
            <input id="agentSpeed" type="range" min="0.8" max="1.5" step="0.05" value="1.0" class="w-full"
                   oninput="document.getElementById('speedLabel').textContent=this.value">
            <span id="speedLabel" class="text-xs text-[#c084fc]">1.0</span>
          </div>
          <div>
            <label class="text-xs text-[#7a7a8e] mb-1 block">🤖 Script Template</label>
            <textarea id="agentScript" rows="4" class="w-full px-3 py-2 bg-[#1a1a28] rounded-lg border border-[#252533] text-xs font-mono"
                      placeholder="You are a professional employee of {{ biz_name }}. Help book more clients. You are a real person — never mention being AI, a robot, or software."></textarea>
          </div>
          <div>
            <label class="text-xs text-[#7a7a8e] mb-1 block">🧠 Knowledge Base</label>
            <textarea id="agentKB" rows="5" class="w-full px-3 py-2 bg-[#1a1a28] rounded-lg border border-[#252533] text-xs font-mono"
                      placeholder="Business-specific knowledge and information the agent should know."></textarea>
            <div class="flex gap-2 mt-2">
              <button onclick="generateKBAgent()" id="genKBAgentBtn" class="btn-secondary text-xs">🤖 Auto-Generate KB</button>
            </div>
            <div id="kbAgentGenStatus" class="text-xs mt-1 hidden"></div>
          </div>
        </div>

        <div class="flex gap-3 mt-5 pt-4 border-t border-[#252533]">
          <button onclick="saveAgent()" class="btn-primary text-sm flex-1" id="saveAgentBtn">💾 Save Agent</button>
          <button onclick="closeAgentModal()" class="btn-outline text-sm">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Agents JavaScript -->
  <script>
  function loadAgents() {
    var list = document.getElementById('agentsList');
    var loading = document.getElementById('agentsLoading');
    loading.style.display = 'block';
    list.innerHTML = '';

    fetch('/api/agents/list').then(function(r){return r.json()}).then(function(d){
      loading.style.display = 'none';
      if (!d.success) { list.innerHTML = '<div class="text-red-400 text-center py-4">'+d.error+'</div>'; return; }

      var agents = d.agents || [];
      var max = d.max_agents || 1;
      var count = d.agent_count || 0;

      // Update limit bar
      var bar = document.getElementById('agentLimitBar');
      bar.style.display = 'block';
      document.getElementById('agentCountLabel').textContent = 'Agents: ' + count;
      document.getElementById('agentMaxLabel').textContent = 'Max: ' + max;
      var pct = Math.min(100, (count / max) * 100);
      var prog = document.getElementById('agentProgressBar');
      prog.style.width = pct + '%';
      prog.style.background = pct > 80 ? 'linear-gradient(135deg,#ef4444,#ec4899)' : 'linear-gradient(135deg,#a855f7,#ec4899)';

      // Toggle add button
      document.getElementById('addAgentBtn').style.display = count >= max ? 'none' : 'inline-flex';

      if (agents.length === 0) {
        list.innerHTML = '<div class="text-center py-8 text-[#5c5c70]"><p class="text-4xl mb-3">🤖</p><p>No agents yet. Create your first one!</p></div>';
        return;
      }

      var html = '';
      for (var i = 0; i < agents.length; i++) {
        var a = agents[i];
        var kbPreview = (a.knowledge_base || '').substring(0, 80);
        var scriptPreview = (a.script_template || '').substring(0, 80);
        html += '<div class="card mb-3 p-4">';
        html += '<div class="flex items-start justify-between">';
        html += '<div class="flex items-center gap-3">';
        html += '<div class="w-10 h-10 rounded-full flex items-center justify-center text-lg" style="background:linear-gradient(135deg,#a855f7,#ec4899)">🤖</div>';
        html += '<div><h4 class="font-semibold text-sm">' + (a.name || 'Unnamed') + '</h4>';
        html += '<span class="text-xs text-[#c084fc]">' + (a.call_count || 0) + ' calls</span>';
        html += '</div></div>';
        html += '<div class="flex gap-2">';
        html += '<button onclick="editAgent(\'' + a.id + '\')" class="btn-secondary text-xs" style="padding:4px 10px">✏️ Edit</button>';
        if (a.phone_number) {
          html += '<span class="text-xs text-[#4ade80] flex items-center" style="padding:4px 8px">📱 ' + escHtml(a.phone_number) + '</span>';
        } else {
          html += '<button onclick="buyAgentNumber(\'' + a.id + '\',\'' + (a.name || '').replace(/'/g,"\\'") + '\')" class="btn-primary text-xs" style="padding:4px 10px">📱 Get Number</button>';
        }
        html += '<button onclick="deleteAgent(\'' + a.id + '\',\'' + (a.name || '').replace(/'/g,"\\'") + '\')" class="btn-outline text-xs text-red-400" style="padding:4px 10px">🗑️</button>';
        html += '</div></div>';

        if (a.knowledge_base) {
          html += '<div class="mt-2 text-xs text-[#7a7a8e]"><span class="text-[#c084fc]">🧠 KB:</span> ' + escHtml(kbPreview) + (a.knowledge_base.length > 80 ? '...' : '') + '</div>';
        }
        if (a.script_template) {
          html += '<div class="mt-1 text-xs text-[#7a7a8e]"><span class="text-[#818cf8]">🤖 Script:</span> ' + escHtml(scriptPreview) + (a.script_template.length > 80 ? '...' : '') + '</div>';
        }
        if (a.voice_id) {
          html += '<div class="mt-1 text-xs text-[#7a7a8e]">🎙️ Voice: ' + escHtml(a.voice_id) + '</div>';
        }
        html += '</div>';
      }
      list.innerHTML = html;
    }).catch(function(e){
      loading.style.display = 'none';
      list.innerHTML = '<div class="text-red-400 text-center py-4">Error loading agents</div>';
    });
  }

  function showCreateAgent() {
    document.getElementById('editAgentId').value = '';
    document.getElementById('agentModalTitle').textContent = '🤖 New Agent';
    document.getElementById('agentName').value = '';
    document.getElementById('agentPhone').value = '';
    document.getElementById('agentVoice').value = '';
    document.getElementById('agentSpeed').value = '1.0';
    document.getElementById('speedLabel').textContent = '1.0';
    document.getElementById('agentScript').value = '';
    document.getElementById('agentKB').value = '';
    document.getElementById('saveAgentBtn').textContent = '💾 Create Agent';
    document.getElementById('agentModal').style.display = 'flex';
  }

  function editAgent(aid) {
    fetch('/api/agents/get/' + aid).then(function(r){return r.json()}).then(function(d){
      if (!d.success || !d.agent) { alert('Agent not found'); return; }
      var a = d.agent;
      document.getElementById('editAgentId').value = a.id;
      document.getElementById('agentModalTitle').textContent = '✏️ Edit: ' + (a.name || '');
      document.getElementById('agentName').value = a.name || '';
      document.getElementById('agentPhone').value = a.phone_number || '';
      document.getElementById('agentVoice').value = a.voice_id || '';
      document.getElementById('agentSpeed').value = a.voice_speed || '1.0';
      document.getElementById('speedLabel').textContent = a.voice_speed || '1.0';
      document.getElementById('agentScript').value = a.script_template || '';
      document.getElementById('agentKB').value = a.knowledge_base || '';
      document.getElementById('saveAgentBtn').textContent = '💾 Save Changes';
      document.getElementById('agentModal').style.display = 'flex';
    }).catch(function(){ alert('Error loading agent'); });
  }

  function closeAgentModal() {
    document.getElementById('agentModal').style.display = 'none';
  }

  function saveAgent() {
    var aid = document.getElementById('editAgentId').value;
    var data = {
      agent_id: aid || undefined,
      name: document.getElementById('agentName').value.trim(),
      voice_id: document.getElementById('agentVoice').value,
      voice_speed: document.getElementById('agentSpeed').value,
      script_template: document.getElementById('agentScript').value.trim(),
      knowledge_base: document.getElementById('agentKB').value.trim()
    };
    var phone = document.getElementById('agentPhone').value;
    if (phone) data.phone_number = phone;

    // Fix: empty required field
    if (!data.name) { alert('Agent name is required'); return; }

    var btn = document.getElementById('saveAgentBtn');
    btn.disabled = true;
    btn.textContent = '⏳ Saving...';

    var endpoint = aid ? '/api/agents/update' : '/api/agents/create';
    fetch(endpoint, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(data)
    }).then(function(r){return r.json()}).then(function(d){
      if (d.success) {
        closeAgentModal();
        loadAgents();
      } else {
        alert(d.error || 'Error saving agent');
      }
      btn.disabled = false;
      btn.textContent = aid ? '💾 Save Changes' : '💾 Create Agent';
    }).catch(function(){
      alert('Error saving agent');
      btn.disabled = false;
      btn.textContent = aid ? '💾 Save Changes' : '💾 Create Agent';
    });
  }

  function deleteAgent(aid, name) {
    if (!confirm('Delete agent "' + name + '"? This cannot be undone.')) return;
    fetch('/api/agents/delete/' + aid, {method: 'DELETE'}).then(function(r){return r.json()}).then(function(d){
      if (d.success) { loadAgents(); }
      else { alert(d.error || 'Error deleting agent'); }
    }).catch(function(){ alert('Error deleting agent'); });
  }

  function buyAgentNumber(aid, name) {
    if (!confirm('Buy a new phone number for "' + name + '"? This costs $1-2/mo and is assigned to this agent instantly.')) return;
    var btn = event.target;
    btn.disabled = true;
    btn.textContent = '⏳ Buying...';
    fetch('/api/agents/buy-number', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({agent_id: aid, area_code: ''})
    }).then(function(r){return r.json()}).then(function(d){
      if (d.success) { alert(d.message); loadAgents(); }
      else { alert(d.error || 'Error buying number'); btn.disabled = false; btn.textContent = '📱 Get Number'; }
    }).catch(function(){
      alert('Error buying number');
      btn.disabled = false;
      btn.textContent = '📱 Get Number';
    });
  }

  function generateKBAgent() {
    var btn = document.getElementById('genKBAgentBtn');
    var status = document.getElementById('kbAgentGenStatus');
    btn.disabled = true;
    btn.textContent = '⏳ Generating...';
    status.className = 'text-xs mt-1 text-[#c084fc]';
    status.textContent = 'Generating knowledge base...';
    status.style.display = 'block';

    fetch('/api/generate-kb', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({type: 'outbound'})
    }).then(function(r){return r.json()}).then(function(d){
      status.textContent = d.success ? '✅ KB generated!' : (d.error || 'Failed');
      status.style.color = d.success ? '#4ade80' : '#ef4444';
      if (d.success && d.knowledge_base) {
        document.getElementById('agentKB').value = d.knowledge_base;
      }
      btn.disabled = false;
      btn.textContent = '🤖 Auto-Generate KB';
    }).catch(function(){
      status.textContent = '❌ Error generating KB';
      status.style.color = '#ef4444';
      btn.disabled = false;
      btn.textContent = '🤖 Auto-Generate KB';
    });
  }

  function escHtml(s) {
    if (!s) return '';
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // Load agents when tab is active
  document.addEventListener('DOMContentLoaded', function(){
    var params = new URLSearchParams(window.location.search);
    if (params.get('tab') === 'agents') { loadAgents(); }
  });
  // Also check on tab switch
  var _orig = window.onhashchange;
  window.onhashchange = function() {
    var params = new URLSearchParams(window.location.search);
    if (params.get('tab') === 'agents') { setTimeout(loadAgents, 100); }
    if (_orig) _orig();
  };
  </script>

  <!-- ======== TAB: SETTINGS ======== -->
  {% elif tab == 'settings' %}
  <div class="grid md:grid-cols-2 gap-6">
    <div class="card md:col-span-2">
      <h3 class="font-bold mb-4">🎙️ Script & Knowledge Base</h3>
      <form method="POST" action="/update-script">
        <div class="grid md:grid-cols-2 gap-4 mb-4">
          <div>
            <label class="text-xs font-semibold text-[#c084fc] block mb-2">🧠 System Prompt (Script)</label>
            <p class="text-xs text-[#7a7a8e] mb-2">Instructions the AI follows during calls. <strong>Saves to Vapi automatically.</strong></p>
            <textarea name="script" rows="8" class="w-full text-xs" id="scriptTextarea">{{ biz_info.script_template or '' }}</textarea>
          </div>
          <div>
            <label class="text-xs font-semibold text-[#c084fc] block mb-2">📚 Knowledge Base</label>
            <p class="text-xs text-[#7a7a8e] mb-2">Facts & info the AI references during calls. <strong>Saves to Vapi automatically.</strong></p>
            <textarea name="knowledge_base" rows="8" class="w-full text-xs" id="kbTextarea">{{ biz_info.knowledge_base or '' }}</textarea>
          </div>
        </div>
        <!-- Vapi-specific settings row -->
        <div class="grid md:grid-cols-3 gap-4 mb-4 p-4 rounded-lg" style="background:rgba(168,85,247,0.05);border:1px solid rgba(168,85,247,0.15)">
          <div>
            <label class="text-xs font-semibold text-[#c084fc] block mb-1">🗣️ First Message</label>
            <p class="text-xs text-[#7a7a8e] mb-1">Greeting the AI says when it answers.</p>
            <input type="text" name="first_message" value="{{ biz_info.first_message or '' }}" placeholder="e.g. Hi, thanks for calling! How can I help?" style="width:100%;padding:8px 12px;border-radius:8px;border:1px solid #252533;background:#0c0c18;color:#f1f1f5;font-size:12px">
          </div>
          <div>
            <label class="text-xs font-semibold text-[#c084fc] block mb-1">🎤 Assistant Speaks First</label>
            <p class="text-xs text-[#7a7a8e] mb-1">AI speaks immediately or waits for caller.</p>
            <select name="first_message_mode" style="width:100%;padding:8px 12px;border-radius:8px;border:1px solid #252533;background:#0c0c18;color:#f1f1f5;font-size:12px">
              <option value="assistant-speaks-first" {% if biz_info.first_message_mode == 'assistant-speaks-first' or not biz_info.first_message_mode %}selected{% endif %}>✅ Assistant Speaks First</option>
              <option value="assistant-waits" {% if biz_info.first_message_mode == 'assistant-waits' %}selected{% endif %}>🔇 Assistant Waits for Caller</option>
            </select>
          </div>
          <div>
            <label class="text-xs font-semibold text-[#c084fc] block mb-1">🤖 Voice Provider</label>
            <p class="text-xs text-[#7a7a8e] mb-1">TTS engine for the AI voice.</p>
            <select name="voice_provider" style="width:100%;padding:8px 12px;border-radius:8px;border:1px solid #252533;background:#0c0c18;color:#f1f1f5;font-size:12px">
            <option value="11labs" {% if not biz_info.voice_provider or biz_info.voice_provider == '11labs' %}selected{% endif %}>ElevenLabs</option>
            <option value="vapi" {% if biz_info.voice_provider == 'vapi' %}selected{% endif %}>Vapi</option>
            <option value="azure" {% if biz_info.voice_provider == 'azure' %}selected{% endif %}>Azure</option>
            </select>
          </div>
        </div>
        <div class="flex gap-2 items-center flex-wrap">
          <button type="button" onclick="generateKB('outbound')" id="genKBBtn" class="btn-secondary text-xs" style="padding:6px 14px">🤖 AI Generate KB</button>
          <button type="button" onclick="generateKB('inbound')" id="genInboundBtn" class="btn-secondary text-xs" style="padding:6px 14px">📞 AI Generate Inbound KB</button>
          <button type="submit" class="btn-primary text-xs" style="padding:6px 20px">💾 Save All → Vapi</button>
          <span id="kbGenStatus" class="text-xs"></span>
        </div>
        <div id="vapiSyncStatus" class="text-xs text-green-400 hidden mt-2">✅ Synced to Vapi assistant</div>
      </form>
    </div>
    <div class="card md:col-span-2">
      <h3 class="font-bold mb-3">📄 Documents &amp; Menus <span class="text-xs font-normal text-[#7a7a8e]">— the AI answers from these</span></h3>
      <p class="text-xs text-[#7a7a8e] mb-3">Upload your <strong>menu</strong>, <strong>inventory</strong>, price list — or add a website URL. The AI reads them to answer callers and texts (e.g. pizza menu to place orders, car inventory to search for cars).</p>
      <div class="grid md:grid-cols-2 gap-4 mb-4">
        <div style="padding:14px;border-radius:10px;background:#1a1a26;border:1px solid #252533">
          <label class="text-xs font-semibold text-[#c084fc] block mb-2">📎 Upload File</label>
          <p class="text-xs text-[#7a7a8e] mb-2">.txt &nbsp;.md &nbsp;.csv &nbsp;.json &nbsp;.pdf &nbsp;(max 3MB)</p>
          <div class="flex gap-2">
            <input type="file" id="kbFileInput" accept=".txt,.md,.csv,.json,.pdf" style="flex:1;font-size:12px;color:#f1f1f5">
            <button type="button" onclick="uploadKbDoc()" class="btn-primary text-xs" style="padding:6px 16px;white-space:nowrap">⬆️ Upload</button>
          </div>
        </div>
        <div style="padding:14px;border-radius:10px;background:#1a1a26;border:1px solid #252533">
          <label class="text-xs font-semibold text-[#c084fc] block mb-2">🌐 Add Website URL</label>
          <p class="text-xs text-[#7a7a8e] mb-2">Fetches the page text (menu site, inventory page, catalog)</p>
          <div class="flex gap-2">
            <input type="text" id="kbUrlInput" placeholder="https://yourmenu.com/menu" style="flex:1;font-size:12px;padding:8px 12px;border-radius:8px;border:1px solid #252533;background:#0c0c18;color:#f1f1f5">
            <button type="button" onclick="addKbUrl()" class="btn-primary text-xs" style="padding:6px 16px;white-space:nowrap">➕ Add</button>
          </div>
        </div>
      </div>
      <div id="kbDocStatus" class="text-xs mb-2"></div>
      <div class="flex flex-wrap gap-2">
        {% for d in kb_documents %}
        <div class="flex items-center gap-2" style="padding:6px 12px;border-radius:8px;background:#1a1a26;border:1px solid #252533;font-size:12px">
          <span>{{ '📄' if d['doc_type']=='file' else '🌐' }}</span>
          <span class="max-w-[220px] truncate" title="{{ d['name'] }}">{{ d['name'] }}</span>
          <span class="text-[#7a7a8e]">({{ ((d['size'] or 0)/1024)|round(1) }} KB)</span>
          <button onclick="deleteKbDoc('{{ d['id'] }}')" class="text-red-400 hover:text-red-300" title="Delete">✕</button>
        </div>
        {% else %}
        <p class="text-xs text-[#7a7a8e]">No documents yet — upload a menu or add a URL to get started.</p>
        {% endfor %}
      </div>
    </div>
    <div class="card">
      <h3 class="font-bold mb-3">🤖 AI SMS Replies</h3>
      <form method="POST" action="/update-sms-ai">
        <p class="text-xs text-[#7a7a8e] mb-3">When a customer texts this number, the AI replies automatically using your knowledge base — answers questions, schedules appointments, and sends confirmations.</p>
        <label class="flex items-center gap-2 cursor-pointer" style="padding:10px 14px;border-radius:8px;background:#1a1a26;border:1px solid #252533">
          <input type="checkbox" name="sms_ai_enabled" value="1" {% if biz_info.sms_ai_enabled %}checked{% endif %} style="width:18px;height:18px;accent-color:#c084fc">
          <span class="text-sm">Enable AI auto-replies to SMS</span>
        </label>
        <button type="submit" class="btn-primary text-xs mt-3" style="padding:6px 20px">💾 Save</button>
      </form>
    </div>
    <div class="card">
      <h3 class="font-bold mb-3">🗣️ AI Voice</h3>
      <form method="POST" action="/update-voice">
        <p class="text-xs text-[#7a7a8e] mb-2">▶️ Click <b style="color:#c084fc">Play</b> to preview a voice · 👆 click a row to <b style="color:#c084fc">select</b> it (highlighted instantly), then hit Save.</p>
        <div class="text-xs mb-2" style="color:#4ade80;font-weight:600">🎙️ Selected: <span id="voiceSelectedName">{{ biz_info.voice_id or 'burt' }}</span></div>
        {% set voice_icons = {'burt':'👨‍💼','indy':'👩','michael':'🧔','emma':'👩‍🦰','antoni':'🧑'} %}
        <div class="space-y-2 mb-4" id="voiceList">
        {% for v in voices %}
        {% set is_active = biz_info.voice_id == v.id %}
        <div class="voice-row flex items-center gap-3 p-3 rounded-lg cursor-pointer" data-vid="{{ v.id }}"
             style="background:{% if is_active %}rgba(168,85,247,0.15);border:1px solid #a855f7{% else %}#1a1a26;border:1px solid #252533{% endif %}"
             onclick="selectVoiceRow(this)">
          <span class="voice-check" style="font-size:16px;width:18px;text-align:center">{% if is_active %}●{% else %}○{% endif %}</span>
          <span style="font-size:22px">{{ voice_icons.get(v.id, '🎙️') }}</span>
          <div class="flex-1"><div class="voice-name font-medium text-sm" style="color:{% if is_active %}#c084fc{% endif %}">{{ v.name }}</div><div class="text-xs text-[#5c5c70]">{{ v.provider }}</div></div>
          <button type="button" onclick="event.stopPropagation();playVoice('{{ v.id }}')" class="btn-secondary" style="padding:4px 10px;font-size:12px">▶️ Play</button>
          {% if is_active %}<span class="voice-state badge badge-success">✓ Active</span>{% else %}<span class="voice-state badge" style="display:none;background:rgba(168,85,247,0.15);color:#c084fc">✓ Selected</span>{% endif %}
        </div>
        {% endfor %}
        </div>
        <input type="hidden" name="voice_id" id="voice_id" value="{{ biz_info.voice_id or 'burt' }}">
        <script>
        function selectVoiceRow(el){
          var id = el.getAttribute('data-vid');
          document.querySelectorAll('.voice-row').forEach(function(r){
            r.style.background = '#1a1a26';
            r.style.borderColor = '#252533';
            r.querySelector('.voice-check').textContent = '○';
            var nm = r.querySelector('.voice-name');
            if (nm) nm.style.color = '';
            var st = r.querySelector('.voice-state');
            if (st) { st.style.display = 'none'; st.textContent = '✓ Selected'; }
          });
          el.style.background = 'rgba(168,85,247,0.15)';
          el.style.borderColor = '#a855f7';
          el.querySelector('.voice-check').textContent = '●';
          var n = el.querySelector('.voice-name');
          if (n) { n.style.color = '#c084fc'; document.getElementById('voiceSelectedName').textContent = n.textContent; }
          var s = el.querySelector('.voice-state');
          if (s) { s.style.display = 'inline-block'; }
          document.getElementById('voice_id').value = id;
        }
        </script>
        <div class="grid grid-cols-2 gap-3 mb-3">
          <div><label class="text-xs text-[#7a7a8e] block mb-1">🌐 Language</label><select name="language">{% for lang_id, lang_name in languages.items() %}<option value="{{ lang_id }}" {% if biz_info.language == lang_id %}selected{% endif %}>{{ lang_name }}</option>{% endfor %}</select></div>
          <div><label class="text-xs text-[#7a7a8e] block mb-1">⚡ Speed</label><div class="flex items-center gap-2"><input type="range" name="voice_speed" min="0.7" max="2.0" step="0.05" value="{{ biz_info.voice_speed or 1.15 }}" oninput="this.nextElementSibling.textContent=parseFloat(this.value).toFixed(2)+'x'" class="flex-1"><output class="text-sm font-bold text-[#4ade80]" style="width:48px;text-align:center">{{ '%.2f'|format(biz_info.voice_speed|float if biz_info.voice_speed else 1.15) }}x</output></div></div>
        </div>
        <button type="submit" class="btn-primary text-xs w-full">💾 Save Voice Settings</button>
      </form>
    </div>
    <div class="card">
      <h3 class="font-bold mb-3">📞 Call Forwarding</h3>
      <form method="POST" action="/update-forwarding">
        <input type="text" name="forward_to" placeholder="+1234567890" value="{{ biz_info.forward_to or '' }}" class="mb-2">
        <select name="forward_when" class="mb-2"><option value="always" {% if biz_info.forward_when == 'always' %}selected{% endif %}>Always</option><option value="hours" {% if biz_info.forward_when == 'hours' %}selected{% endif %}>Business Hours</option><option value="after" {% if biz_info.forward_when == 'after' %}selected{% endif %}>After Hours</option></select>
        <button type="submit" class="btn-primary text-xs w-full">Save Forwarding</button>
      </form>
    </div>
    <div class="card">
      <h3 class="font-bold mb-3">📠 Voicemail Detection</h3>
      <p class="text-xs text-[#7a7a8e] mb-2">Detect voicemail and leave a message with callback number.</p>
      <form method="POST" action="/update-voicemail-settings">
        <select name="voicemail_detection" class="mb-2"><option value="google" {% if biz_info.voicemail_detection == 'google' %}selected{% endif %}>Google</option><option value="twilio" {% if biz_info.voicemail_detection == 'twilio' %}selected{% endif %}>Twilio</option><option value="off" {% if biz_info.voicemail_detection == 'off' or not biz_info.voicemail_detection %}selected{% endif %}>Off</option></select>
        <select name="voicemail_action" class="mb-2" onchange="document.getElementById('vmMsgWrap').style.display=this.value=='leave_message'?'block':'none'"><option value="hangup" {% if biz_info.voicemail_action == 'hangup' or not biz_info.voicemail_action %}selected{% endif %}>Hang up</option><option value="leave_message" {% if biz_info.voicemail_action == 'leave_message' %}selected{% endif %}>Leave message</option></select>
        <div id="vmMsgWrap" {% if biz_info.voicemail_action != 'leave_message' %}style="display:none"{% endif %}><label class="text-xs text-[#7a7a8e] block mb-1">📝 Message</label><textarea name="voicemail_message" rows="3" class="w-full text-xs">{{ biz_info.voicemail_message or '' }}</textarea></div>
        <button type="submit" class="btn-primary text-xs w-full mt-2">💾 Save Voicemail</button>
        </form>
        </div>
        <div class="card">
        <h3 class="font-bold mb-3">📅 Booking (Cal.com)</h3>
        <p class="text-xs text-[#5c5c70] mb-2">Connect Cal.com for appointment booking.</p>
        <label class="block text-xs font-medium text-[#a0a0b8] mb-1">Cal.com Username</label>
        <input type="text" id="calUsernameInput" value="{{ landing_page.get('cal_username','') if landing_page else '' }}" placeholder="your-username" class="w-full bg-[#1a1a28] border border-[#252533] rounded-lg px-3 py-2 text-white text-sm mb-3">
        <label class="block text-xs font-medium text-[#a0a0b8] mb-1">Event Type</label>
        <select id="calEventSlugInput" class="w-full bg-[#1a1a28] border border-[#252533] rounded-lg px-3 py-2 text-white text-sm mb-3">
        <option value="30min" {% if landing_page and landing_page.get('cal_event_slug') == '30min' %}selected{% endif %}>30 min meeting</option>
        <option value="15min" {% if landing_page and landing_page.get('cal_event_slug') == '15min' %}selected{% endif %}>15 min meeting</option>
        </select>
        <button onclick="saveCalcomSettings()" class="btn-primary text-xs w-full">💾 Save Booking Settings</button>
        <div id="calcomStatus" class="text-xs text-green-400 hidden mt-2"></div>
        <div class="mt-2 text-[10px] text-[#5c5c70]">
        Your page: <a href="https://cal.com/{{ landing_page.get('cal_username','pablo-d-i2xmhr') if landing_page else 'pablo-d-i2xmhr' }}/{{ landing_page.get('cal_event_slug','30min') if landing_page else '30min' }}" target="_blank" id="calcomUrlDisplay" class="text-[#a855f7]">https://cal.com/{{ landing_page.get('cal_username','pablo-d-i2xmhr') if landing_page else 'pablo-d-i2xmhr' }}/{{ landing_page.get('cal_event_slug','30min') if landing_page else '30min' }}</a>
        </div>
        </div>
        </div>

        <script>
        function saveCalcomSettings() {
          var username = document.getElementById('calUsernameInput').value.trim();
          var slug = document.getElementById('calEventSlugInput').value;
          var status = document.getElementById('calcomStatus');
          var fd = new FormData();
          fd.append('username', username || 'pablo-d-i2xmhr');
          fd.append('event_slug', slug);
          status.classList.remove('hidden');
          status.textContent = '⏳ Saving...';
          status.style.color = '#c084fc';
          fetch('/api/calcom/save-settings', { method: 'POST', body: fd })
            .then(function(r){ return r.json(); })
            .then(function(d){
              if (d.success) {
                status.textContent = '✅ ' + d.message;
                status.style.color = '#4ade80';
                var urlEl = document.getElementById('calcomUrlDisplay');
                if (urlEl) urlEl.href = 'https://cal.com/' + (username || 'pablo-d-i2xmhr') + '/' + slug;
                if (urlEl) urlEl.textContent = 'https://cal.com/' + (username || 'pablo-d-i2xmhr') + '/' + slug;
              } else {
                status.textContent = '❌ ' + (d.message || 'Save failed');
                status.style.color = '#ef4444';
              }
            })
            .catch(function(){
              status.textContent = '❌ Network error';
              status.style.color = '#ef4444';
            });
        }
        </script>

        <!-- Call Settings -->
  <div class="grid md:grid-cols-3 gap-6 mt-6">
    <div class="card"><h3 class="font-bold mb-3">⏱️ Max Tokens</h3><p class="text-xs text-[#7a7a8e] mb-2">How much the AI can say per response.</p><form method="POST" action="/update-call-settings"><input type="range" name="max_tokens" min="100" max="1000" step="50" value="{{ biz_info.max_tokens or 200 }}" oninput="this.nextElementSibling.textContent=this.value" class="w-full"><output class="text-sm font-bold text-[#4ade80] block text-center mb-2">{{ biz_info.max_tokens or 200 }}</output><button type="submit" class="btn-primary text-xs w-full">Save</button></form></div>
    <div class="card"><h3 class="font-bold mb-3">🔇 Silence Timeout</h3><p class="text-xs text-[#7a7a8e] mb-2">Seconds before hanging up.</p><form method="POST" action="/update-call-settings"><input type="range" name="silence_timeout" min="3" max="30" step="1" value="{{ biz_info.silence_timeout or 10 }}" oninput="this.nextElementSibling.textContent=this.value+'s'" class="w-full"><output class="text-sm font-bold text-[#4ade80] block text-center mb-2">{{ biz_info.silence_timeout or 10 }}s</output><button type="submit" class="btn-primary text-xs w-full">Save</button></form></div>
    <div class="card"><h3 class="font-bold mb-3">⏰ Max Call Duration</h3><p class="text-xs text-[#7a7a8e] mb-2">Max call length.</p><form method="POST" action="/update-call-settings"><input type="range" name="max_duration" min="60" max="1800" step="30" value="{{ biz_info.max_duration_seconds or 300 }}" oninput="this.nextElementSibling.textContent=this.value+'s'" class="w-full"><output class="text-sm font-bold text-[#4ade80] block text-center mb-2">{{ biz_info.max_duration_seconds or 300 }}s</output><button type="submit" class="btn-primary text-xs w-full">Save</button></form></div>
  </div>

  <!-- Two-Factor Authentication (user TOTP) -->
  <div class="card mt-6">
    <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
      <h3 class="font-bold">🔐 Two-Factor Authentication</h3>
      {% if user_2fa.enabled %}
      <span class="badge badge-success">✅ Enabled</span>
      {% else %}
      <span class="badge badge-inactive">Off</span>
      {% endif %}
    </div>
    <p class="text-xs text-[#7a7a8e] mb-3">Protect your dashboard: after enabling, a 6-digit code from your authenticator app (Google Authenticator / Authy) is required at every login.</p>

    {% if user_2fa.enabled %}
    <div class="flex gap-2 flex-wrap">
      <form method="POST" action="/2fa/backup-codes"><button type="submit" class="btn-secondary text-xs" style="padding:8px 16px">🔄 Regenerate Backup Codes</button></form>
      <form method="POST" action="/2fa/disable" onsubmit="return confirm('Disable 2FA for this account?')"><button type="submit" class="btn-danger text-xs" style="padding:8px 16px">Disable 2FA</button></form>
    </div>
    {% elif user_2fa.qr %}
    <div class="bg-[#12121a] rounded-lg p-4 mb-3 text-center">
      <img src="{{ user_2fa.qr }}" alt="2FA QR" class="mx-auto w-48 h-48">
      <p class="text-xs text-[#5c5c70] mt-2">Scan with Google Authenticator / Authy, then enter the 6-digit code.</p>
    </div>
    <form method="POST" action="/2fa/verify" class="flex gap-2 max-w-sm">
      <input type="text" name="code" placeholder="6-digit code" maxlength="6" class="text-center font-mono" autocomplete="one-time-code">
      <button type="submit" class="btn-primary text-xs">Verify & Enable</button>
    </form>
    {% else %}
    <form method="POST" action="/2fa/setup"><button type="submit" class="btn-primary text-xs" style="padding:8px 18px"><i class="fas fa-qrcode mr-1"></i> Enable 2FA</button></form>
    {% endif %}

    {% if user_2fa.new_codes %}
    <div class="bg-[#12121a] border border-yellow-500/30 rounded-lg p-4 mt-4">
      <p class="text-xs text-yellow-400 font-semibold mb-2">⚠️ Save these backup codes somewhere safe. Each one works <strong>once</strong> at login if you lose your phone.</p>
      <div class="grid grid-cols-2 gap-2 font-mono text-sm">
        {% for c in user_2fa.new_codes %}<span class="bg-[#1a1a26] rounded px-3 py-2 text-center">{{ c }}</span>{% endfor %}
      </div>
      <form method="POST" action="/2fa/dismiss-codes" class="mt-3"><button type="submit" class="btn-primary text-xs">I saved them</button></form>
    </div>
    {% endif %}
    {% if user_2fa.backup_count and not user_2fa.new_codes %}
    <p class="text-xs text-[#5c5c70] mt-3">Remaining unused backup codes: <span class="font-bold text-[#f1f1f5]">{{ user_2fa.backup_count }}</span></p>
    {% endif %}
  </div>

